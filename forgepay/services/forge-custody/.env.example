# FORGE Custody — environment configuration
# Copy to .env and fill in real values. Never commit real secrets.

# HTTP
PORT=3019
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=300
# Server-to-server API: leave CORS_ORIGIN unset unless a browser client needs access.
#CORS_ORIGIN=https://console.forgepay.co.za

# Postgres (schema: forge_custody). REQUIRED in production.
DATABASE_URL=postgresql://forgepay:devpassword@localhost:5432/forgepay_dev

# MPC coordinator (Go orchestrator running the 4-of-7 signing ceremony).
# REQUIRED in production — without it the service refuses to start.
# When unset in dev/test, a simulated DevSigner is used (never valid on-chain).
#MPC_COORDINATOR_URL=http://openfireblocks-mpc:3002

# Blockchain RPC used for broadcast + confirmation polling.
# When unset, settlement is simulated (dev/test only).
#BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/<project-id>

# Sanctions screening (compliance-monitor service). When unset, screening is
# SKIPPED WITH A LOGGED WARNING — set this before launch.
#COMPLIANCE_MONITOR_URL=http://compliance-monitor:8004

# Revenue Ontology emission — unified-router webhook ingest.
# WEBHOOK_SECRET is REQUIRED in production and must match the router's secret.
UNIFIED_ROUTER_URL=http://unified-router:3000
WEBHOOK_SECRET=
