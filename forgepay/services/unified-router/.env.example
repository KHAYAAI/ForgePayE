# Unified Router — Webhook normalizer and event orchestrator
# ═══════════════════════════════════════════════════════════════════════════════════
# Aggregates events from Hyperswitch, Kill Bill, Stablecoin/Crypto gateways, and KYAPay.
# Verifies HMAC signatures, normalizes to ForgePayEvent, fans out to merchants.
#
# All secrets injected via K8s secrets / Vault — never hardcoded.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000
LOG_LEVEL=info

# ── PostgreSQL Database ────────────────────────────────────────────────────────────
# Stores webhook delivery state, merchant subscriptions, audit log.
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgepay
DB_PASSWORD=devpassword
DB_NAME=forgepay_dev
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOG_SLOW_MS=500

# ── Redis ──────────────────────────────────────────────────────────────────────────
# Caches recent webhook state, rate limiting, session storage.
REDIS_URL=redis://localhost:6379

# ── Webhook Secrets (HMAC-SHA256 verification) ─────────────────────────────────────
# CRITICAL: Each service signs its outgoing webhooks with its secret.
# Unified-router MUST verify the signature before processing.
# Rotation: Update in K8s secret, re-deploy unified-router. Old signatures will fail.
INTERNAL_WEBHOOK_SECRET=your-internal-webhook-secret-min-32-chars
HYPERSWITCH_WEBHOOK_SECRET=hyperswitch-webhook-secret-min-32-chars
KILLBILL_WEBHOOK_SECRET=killbill-webhook-secret-min-32-chars
MOR_LAYER_WEBHOOK_SECRET=mor-layer-webhook-secret-min-32-chars
STABLECOIN_GW_WEBHOOK_SECRET=stablecoin-gw-webhook-secret-min-32-chars
CRYPTO_GW_WEBHOOK_SECRET=crypto-gw-webhook-secret-min-32-chars
FORGE_CUSTODY_WEBHOOK_SECRET=forge-custody-webhook-secret-min-32-chars
FORGE_WALLET_WEBHOOK_SECRET=forge-wallet-webhook-secret-min-32-chars

# ── Merchant Webhook Delivery ──────────────────────────────────────────────────────
# Timeout (ms) for calling merchant's webhook endpoint. If exceeded, retry.
MERCHANT_WEBHOOK_TIMEOUT_MS=5000
# Max number of retries before marking webhook delivery as failed. Exponential backoff.
MERCHANT_WEBHOOK_MAX_RETRIES=5

# ── Kill Bill API ──────────────────────────────────────────────────────────────────
# Used to enrich subscription/invoice data in webhook normalizer.
KILLBILL_BASE_URL=http://billing-engine:8020
KILLBILL_API_KEY=forgepay
KILLBILL_API_SECRET=

# ── KYAPay Integration ─────────────────────────────────────────────────────────────
# Comma-separated list of trusted JWT issuer URLs for identity/signature verification.
KYAPAY_TRUSTED_ISSUERS=https://skyfire.xyz,https://api.forgepay.com
# ForgePay's own issuer URL (used when we issue identity tokens).
FORGEPAY_ISSUER_URL=https://api.forgepay.com
