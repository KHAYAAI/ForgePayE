{
  "name": "@forgepay/unified-router",
  "version": "0.1.0",
  "private": true,
  "description": "ForgePay unified webhook and event router — normalizes events from all payment services into a single canonical stream",
  "scripts": {
    "dev":        "tsx watch src/index.ts",
    "build":      "tsc -p tsconfig.json",
    "start":      "node dist/index.js",
    "lint":       "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test":       "vitest run"
  },
  "dependencies": {
    "fastify":             "^5.0.0",
    "@fastify/sensible":   "^6.0.0",
    "@fastify/helmet":     "^12.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "ioredis":             "^5.4.1",
    "pg":                  "^8.12.0",
    "zod":                 "^3.23.8",
    "pino":                "^9.3.2",
    "pino-pretty":         "^11.2.1",
    "@opentelemetry/sdk-node":      "^0.52.1",
    "@opentelemetry/auto-instrumentations-node": "^0.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg":   "^8.11.6",
    "typescript":  "^5.5.3",
    "tsx":         "^4.16.2",
    "vitest":      "^2.0.4"
  }
}
