# Agent Decision Framework — ML-driven agent decision engine
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Executes decision trees and ML models for autonomous agent actions.
# Routes to negotiation, evaluates proposals, and enforces risk policies.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3013
LOG_LEVEL=info

# ── Agent Identity Service ────────────────────────────────────────────────────────
# URL to agent-identity for verifying agent credentials and credit scores.
AGENT_IDENTITY_URL=http://localhost:3010

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute. Decision endpoints handle rapid queries.
RATE_LIMIT_PER_MIN=100

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────────
# Stores decision history, model performance metrics, agent risk profiles.
# DATABASE_URL=postgresql://forgepay:password@localhost:5432/decision_framework

# ── Decision Trees and Models ─────────────────────────────────────────────────────
# Path to decision tree configuration files (JSON or YAML).
# Directory should contain decision_trees/*.json files.
# DECISION_TREE_PATH=/etc/forgepay/decision-trees

# ML model version for agent scoring. E.g., 'v1-gpt4-trained', 'v2-claude-2'.
# Models should be stored in model registry (Hugging Face, MLflow, etc.).
MODEL_VERSION=v1-baseline

# ── Risk Policy Engine ────────────────────────────────────────────────────────────
# Maximum transaction size for autonomous agent (USD). Requires human approval beyond.
MAX_AUTONOMOUS_TRANSACTION_USD=10000

# Maximum daily spending limit per agent (USD). Enforced across all transactions.
MAX_DAILY_SPEND_USD=50000

# Minimum credit score to execute "high-value" decisions (> $5000).
MIN_SCORE_FOR_HIGH_VALUE=60

# ── Credit Line Service ────────────────────────────────────────────────────────────
# URL to agent-credit-lines for enforcing credit limits on proposed transactions.
# CREDIT_SERVICE_URL=http://localhost:3016

# ── Negotiation Service ────────────────────────────────────────────────────────────
# URL to agent-negotiation for executing negotiation decisions.
# NEGOTIATION_SERVICE_URL=http://localhost:3011

# ── Compliance Checks ──────────────────────────────────────────────────────────────
# URL to compliance-monitor for AML/sanctions checks before executing decisions.
# COMPLIANCE_SERVICE_URL=http://localhost:8003

# ── Cache (Redis) ──────────────────────────────────────────────────────────────────
# Redis URL for caching decision tree evaluations and model scores.
# REDIS_URL=redis://localhost:6379

# ── Model Evaluation ───────────────────────────────────────────────────────────────
# Enable A/B testing of new decision models. If true, logs shadow recommendations.
# A_B_TESTING_ENABLED=false

# Percentage of requests to route to new model for A/B testing (0-100).
# A_B_TESTING_SPLIT=10

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for decision tree evaluations and model predictions.
# ENABLE_AUDIT_LOG=true

# Enable model inference logging (feature importance, confidence scores).
# ENABLE_MODEL_LOGGING=true
