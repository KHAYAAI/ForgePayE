# FORGE Wallet — environment configuration
# Copy to .env and fill in real values. Never commit real secrets.

# HTTP
PORT=3020
LOG_LEVEL=info
RATE_LIMIT_PER_MIN=120
# Browser clients (dashboard) need CORS; keep the origin list tight.
#CORS_ORIGIN=https://console.forgepay.co.za

# Postgres (schema: forge_wallet). REQUIRED in production.
DATABASE_URL=postgresql://forgepay:devpassword@localhost:5432/forgepay_dev

# JWT signing secret — REQUIRED in production, must be ≥32 chars.
# Tokens are HS256, 1-hour expiry.
JWT_SECRET=

# Platform key for POST /api/v1/agents/wallets (server-to-server).
# REQUIRED in production.
AGENT_API_KEY=

# Routing tier: amounts at/above this (USD) are refused with
# 409 {route:'forge-custody'} so FORGE Payments re-routes them.
LARGE_PAYMENT_THRESHOLD=100000

# Revenue Ontology emission — unified-router webhook ingest.
# WEBHOOK_SECRET is REQUIRED in production and must match the router's secret.
UNIFIED_ROUTER_URL=http://unified-router:3000
WEBHOOK_SECRET=
