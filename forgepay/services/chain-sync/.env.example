# Chain Sync Service — Environment Variables
# Copy to .env and fill in required values before running.
# Required values are marked with: # Required

# Server
PORT=3009

# Database
DATABASE_URL=postgresql://forgepay:devpassword@localhost:5432/forgepay_dev # Required

# Logging
LOG_LEVEL=info

# Blockchain RPC Endpoints
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY # Required
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_KEY
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Sync Configuration
SYNC_INTERVAL_MS=12000
CONFIRMATION_BLOCKS=12
START_BLOCK=latest

# Authentication
API_KEY=your-api-key-here # Required
