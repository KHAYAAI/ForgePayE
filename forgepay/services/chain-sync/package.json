{
  "name": "@forgepay/chain-sync",
  "version": "0.1.0",
  "description": "ForgePay Chain Sync — polls on-chain ZK contract state (Merkle roots + nullifiers) across all EVM chains",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev":        "tsx watch src/index.ts",
    "build":      "tsc",
    "start":      "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint":       "eslint src",
    "test":       "vitest run"
  },
  "dependencies": {
    "fastify":           "^4.27.0",
    "@fastify/helmet":   "^11.1.1",
    "pg":                "^8.12.0",
    "ethers":            "^6.12.1",
    "pino":              "^9.2.0"
  },
  "devDependencies": {
    "@types/node":   "^20.14.0",
    "@types/pg":     "^8.11.6",
    "typescript":    "^5.5.3",
    "tsx":           "^4.16.0",
    "vitest":        "^1.6.0",
    "eslint":        "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser":        "^7.14.1"
  }
}
