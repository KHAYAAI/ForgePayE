# Agent Identity — Identity and credit scoring for autonomous payment agents
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Issues and verifies agent identity credentials, tracks
# credit history, and computes credit scores for lending/risk decisions.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3010
LOG_LEVEL=info

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute. Identity/scoring endpoints are rate-sensitive.
RATE_LIMIT_PER_MIN=200

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────────
# Stores agent profiles, identity credentials, credit scores, transaction history.
# DATABASE_URL=postgresql://forgepay:password@localhost:5432/agent_identity

# ── JWT Configuration ─────────────────────────────────────────────────────────────
# Secret key for signing identity JWT credentials. Must be at least 32 chars.
# Keep in Vault/K8s secret, never commit.
JWT_SECRET=your-jwt-secret-min-32-characters-long
# JWT expiry (hours) for identity credentials.
JWT_EXPIRY_HOURS=24

# ── Identity Issuance ──────────────────────────────────────────────────────────────
# ForgePay's issuer URL (iss claim in JWT).
ISSUER_URL=https://api.forgepay.com
# Audience URL (aud claim in JWT).
AUDIENCE_URL=https://api.forgepay.com

# ── Credit Scoring ────────────────────────────────────────────────────────────────
# Minimum transaction history (number of payments) to be eligible for credit scoring.
MIN_TRANSACTIONS_FOR_SCORE=5

# Lookback window (days) for credit score calculation (e.g., last 90 days).
CREDIT_SCORE_LOOKBACK_DAYS=90

# On-chain reputation contract address (if available).
# REPUTATION_CONTRACT_ADDRESS=0x...

# ── Compliance Hooks ───────────────────────────────────────────────────────────────
# URL to compliance-monitor service for AML/KYC checks during identity issuance.
# COMPLIANCE_SERVICE_URL=http://localhost:8003

# ── Webhooks ───────────────────────────────────────────────────────────────────────
# Internal secret for receiving account status updates.
INTERNAL_WEBHOOK_SECRET=your-webhook-secret

# ── Cache (Redis) ──────────────────────────────────────────────────────────────────
# Redis URL for caching identity tokens and credit scores.
# REDIS_URL=redis://localhost:6379

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for identity issuance and score calculations.
# ENABLE_AUDIT_LOG=true
