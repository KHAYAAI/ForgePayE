# Billing Engine — Subscriptions, metering, and invoicing
# ═══════════════════════════════════════════════════════════════════════════════════
# Kill Bill 0.24.10 (Java/Shiro). Handles subscription lifecycle, usage metering,
# dunning, invoicing, and payment retry logic.
# Integrated with ForgePay via forgepay-payment-plugin.jar.
#
# Plans (see config/catalog/forgepay-base-catalog.xml):
#   - forgepay-growth-monthly: $5/mo (14-day trial)
#   - forgepay-growth-annual: $50/yr (14-day trial)
#   - forgepay-ai-tokens-monthly: $0.001/token (metered)

# ── Server ─────────────────────────────────────────────────────────────────────────
# JVM options. E.g., -Xmx2g for heap size, -XX:+UseG1GC for garbage collector.
KILLBILL_JVM_OPTS=-Xmx1g -Xms512m

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────────
# Kill Bill stores all subscription, invoice, and payment state here.
# Credentials injected via environment variables into killbill.properties.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=killbill
POSTGRES_USER=killbill
POSTGRES_PASSWORD=killbill_dev_password

# ── Notifications / Webhooks ───────────────────────────────────────────────────────
# Kill Bill pushes lifecycle events (SUBSCRIPTION_CREATION, PAYMENT_SUCCESS, etc.)
# to this URL. Unified-router normalizes them into ForgePayEvent.
# (Configured in config/killbill.properties)
# PUSHNOTIFICATION_URL=http://unified-router:8000/webhooks/killbill

# ── Payment Retry Schedule ────────────────────────────────────────────────────────
# Retry a failed subscription payment after 1 day, then after another 1 day, then 3 days.
# Format: comma-separated list of days (built into killbill.properties).
# org.killbill.payment.retry.days=1,1,3

# ── Optional: Redis Cache (for distributed deployments) ─────────────────────────────
# Uncomment to enable Redis caching of subscription/invoice state.
# REDIS_HOST=redis
# REDIS_PORT=6379
# org.killbill.cache.config.redis.url=redis://redis:6379

# ── Admin API Credentials ──────────────────────────────────────────────────────────
# Kill Bill admin API key and secret (used by ForgePay plugins to create subscriptions).
# Default credentials are built-in; override here for production.
# KILLBILL_ADMIN_API_KEY=admin
# KILLBILL_ADMIN_API_PASSWORD=123456789

# ── Catalog URI ────────────────────────────────────────────────────────────────────
# Path to ForgePay's product catalog (plans, add-ons, usage tiers).
# Loaded from: config/catalog/forgepay-base-catalog.xml
# Reload at: POST /1.0/kb/catalog (admin API)
