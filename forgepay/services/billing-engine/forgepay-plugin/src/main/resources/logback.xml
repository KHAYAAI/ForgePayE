<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
    Logback configuration for ForgePay Kill Bill plugin.
    Provides JSON structured logging for production environments.
    -->

    <property name="LOG_DIR" value="${LOG_DIR:-./logs}"/>
    <property name="LOG_LEVEL" value="${LOG_LEVEL:-INFO}"/>

    <!-- Standard console appender for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- File appender for standard logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/forgepay-killbill-plugin.log</file>
        <encoder>
            <pattern>%d{ISO8601} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/forgepay-killbill-plugin.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- JSON structured logging appender for production -->
    <!-- Requires logstash-logback-encoder dependency (optional enhancement) -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/forgepay-killbill-plugin-json.log</file>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"forgepay-killbill-plugin","environment":"${ENVIRONMENT:-development}"}</customFields>
            <includeMdcAsJson>true</includeMdcAsJson>
            <includeMarker>true</includeMarker>
            <timeZone>UTC</timeZone>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/forgepay-killbill-plugin-json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Async appender wrapper for better performance -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>512</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE"/>
    </appender>

    <!-- Logger configuration for ForgePay plugin -->
    <logger name="io.forgepay" level="${LOG_LEVEL}"/>
    <logger name="io.forgepay.killbill.metrics" level="INFO"/>

    <!-- Suppress verbose logging from external libraries -->
    <logger name="org.killbill" level="WARN"/>
    <logger name="com.squareup.okhttp3" level="WARN"/>
    <logger name="io.micrometer" level="WARN"/>

    <!-- Root logger configuration -->
    <root level="${LOG_LEVEL}">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_FILE"/>
        <!-- Uncomment for JSON logging (requires logstash-logback-encoder dependency) -->
        <!-- <appender-ref ref="JSON_FILE"/> -->
    </root>
</configuration>
