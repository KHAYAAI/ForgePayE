# Agent Negotiation — Real-time negotiation engine for autonomous agents
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Facilitates real-time contract and price negotiation between
# autonomous agents, brokers, and merchants. Implements auction mechanics and contract resolution.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3011
LOG_LEVEL=info

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute. Negotiation endpoints require strict rate control.
RATE_LIMIT_PER_MIN=200

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────────
# Stores active negotiations, agent offers, acceptance/rejection history.
# DATABASE_URL=postgresql://forgepay:password@localhost:5432/negotiations

# ── Agent Identity Service ────────────────────────────────────────────────────────
# URL to agent-identity for verifying agent credentials before negotiation.
# AGENT_IDENTITY_URL=http://localhost:3010

# ── Decision Framework Service ────────────────────────────────────────────────────
# URL to agent-decision-framework for intelligent counter-offer generation.
# DECISION_FRAMEWORK_URL=http://localhost:3013

# ── Negotiation Parameters ────────────────────────────────────────────────────────
# Default negotiation timeout (seconds). If exceeded, negotiation expires.
NEGOTIATION_TIMEOUT_SECONDS=300

# Maximum rounds of counter-offers before negotiation is deemed "stalled".
MAX_NEGOTIATION_ROUNDS=10

# Minimum acceptable price/rate change between rounds (percentage).
# Prevents micro-offer spam.
MIN_PRICE_MOVEMENT_PERCENT=0.1

# ── Auction Mechanics ──────────────────────────────────────────────────────────────
# Auction type: 'sealed-bid', 'english', 'dutch'.
# sealed-bid: All bids private until close time.
# english: Ascending bid auction (traditional).
# dutch: Descending price auction.
AUCTION_TYPE=sealed-bid

# Duration of sealed-bid auction (seconds). Default 5 minutes.
AUCTION_DURATION_SECONDS=300

# ── Reputation and Trust ───────────────────────────────────────────────────────────
# Minimum reputation score (0-100) for agents to participate in auctions.
MIN_REPUTATION_SCORE=40

# Apply discount multiplier if agent has poor reputation.
# E.g., 0.9 = 10% penalty on offers from agents with score < MIN_REPUTATION_SCORE.
# REPUTATION_DISCOUNT_MULTIPLIER=0.9

# ── Webhooks ───────────────────────────────────────────────────────────────────────
# Internal secret for receiving negotiation status updates.
INTERNAL_WEBHOOK_SECRET=your-webhook-secret

# ── Cache (Redis) ──────────────────────────────────────────────────────────────────
# Redis URL for caching active negotiations and agent reputation.
# REDIS_URL=redis://localhost:6379

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for negotiation rounds and auction mechanics.
# ENABLE_AUDIT_LOG=true
