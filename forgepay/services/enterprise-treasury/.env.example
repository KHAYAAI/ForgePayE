# Enterprise Treasury — Multi-currency cash flow orchestration
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Reconciles bank balances, performs foreign exchange optimization,
# manages inter-account transfers, and enforces treasury policies.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3012
LOG_LEVEL=info

# ── Bank Connectivity Service ─────────────────────────────────────────────────────
# URL to bank-connectivity service for real-time balance checks and transfers.
BANK_CONNECTIVITY_URL=http://localhost:3006

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute. Prevents abuse of sensitive treasury endpoints.
RATE_LIMIT_PER_MIN=100

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for treasury dashboard and API.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Database (Optional PostgreSQL) ────────────────────────────────────────────────
# Stores treasury policies, FX rates, audit trail, transfer history.
# DATABASE_URL=postgresql://forgepay:password@localhost:5432/treasury

# ── FX Rate Provider ───────────────────────────────────────────────────────────────
# API key for real-time exchange rates (e.g., Alpha Vantage, Polygon.io).
# Used for FX optimization and multi-currency settlement.
# FX_PROVIDER_API_KEY=your-fxprovider-api-key
# FX_PROVIDER_ENDPOINT=https://www.alphavantage.co/query

# ── Treasury Policies ──────────────────────────────────────────────────────────────
# Minimum cash balance to maintain in primary account (USD equivalent).
# Triggers inter-account transfers if balance falls below this.
# MIN_CASH_BALANCE_USD=50000

# Default currency for treasury operations (ISO 4217).
# PRIMARY_CURRENCY=USD

# FX rebalancing strategy: 'conservative' (hold USD), 'aggressive' (yield-seeking).
# FX_STRATEGY=conservative

# Maximum daily transfer amount (USD equivalent) to prevent large mistakes.
# MAX_DAILY_TRANSFER_USD=500000

# ── Webhooks ───────────────────────────────────────────────────────────────────────
# Internal webhook secret for receiving balance update events from bank-connectivity.
INTERNAL_WEBHOOK_SECRET=your-webhook-secret

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for treasury operations (reconciliation, transfers, FX).
# ENABLE_AUDIT_LOG=true
