# Bank Whitelabel Service — Environment Variables
# Copy to .env and fill in required values before running.
# Required values are marked with: # Required

# Server
PORT=3011
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_PER_MIN=100

# Upstream Services
BANK_CONNECTIVITY_URL=http://bank-connectivity:3006
ACCOUNTS_SERVICE_URL=http://accounts-service:3008

# Branding
WHITE_LABEL_THEME=default

# Authentication
API_KEY=your-api-key-here # Required: inject from Vault

# CORS
CORS_ORIGINS=http://localhost:3000
