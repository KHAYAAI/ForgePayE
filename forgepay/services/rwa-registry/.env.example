# RWA Registry — Real-world asset issuance and redemption
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Manages tokenized real-world assets (commodities, equities, bonds).
# Issues on-chain RWA tokens backed by real collateral, tracks redemptions.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3008
LOG_LEVEL=info

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute. Asset issuance is strictly rate-controlled.
RATE_LIMIT_PER_MIN=100

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────────
# Stores RWA token issuance records, collateral tracking, redemption history.
# DATABASE_URL=postgresql://forgepay:password@localhost:5432/rwa_registry

# ── Blockchain RPC Endpoints ──────────────────────────────────────────────────────
# Ethereum for cross-chain message passing (CCMP) and token transfers.
# ETH_RPC_URL=https://cloudflare-eth.com

# Polygon for RWA token minting and redemption events.
# POLYGON_RPC_URL=https://polygon-rpc.com

# ── Smart Contracts ───────────────────────────────────────────────────────────────
# Address of RWA token contract on Polygon (ERC-20).
# RWA_TOKEN_ADDRESS=0x...

# Address of collateral custody contract (holds underlying assets).
# COLLATERAL_CUSTODY_ADDRESS=0x...

# ── Asset Configuration ────────────────────────────────────────────────────────────
# List of supported RWA assets: commodities, equities, bonds.
# Format: asset_type:ticker (e.g., commodity:GOLD, equity:AAPL, bond:UST)
# SUPPORTED_ASSETS=commodity:GOLD,commodity:SILVER,equity:AAPL,equity:TSLA,bond:UST

# Minimum redemption amount (USD). Prevent spam micro-redemptions.
MIN_REDEMPTION_USD=100

# Maximum issuance per day (USD). Risk control for rapid expansion.
MAX_DAILY_ISSUANCE_USD=1000000

# ── Price Feeds ────────────────────────────────────────────────────────────────────
# Chainlink oracle for asset price feeds. E.g., for GOLD/USD, SPY/USD.
# CHAINLINK_REGISTRY_ADDRESS=0x...

# ── Treasury Account ───────────────────────────────────────────────────────────────
# Enterprise-treasury service URL for recording collateral movements.
# TREASURY_SERVICE_URL=http://localhost:3012

# ── Compliance ─────────────────────────────────────────────────────────────────────
# Compliance-monitor service URL for KYC/AML checks on redemptions.
# COMPLIANCE_SERVICE_URL=http://localhost:8003

# ── Webhooks ───────────────────────────────────────────────────────────────────────
# Internal secret for receiving oracle updates and collateral status changes.
INTERNAL_WEBHOOK_SECRET=your-webhook-secret

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for token issuance and redemption.
# ENABLE_AUDIT_LOG=true
