PORT=3007
JWT_SECRET=

# ── PostgreSQL Database ────────────────────────────────────────────────────
# Stores yield positions, sweep configs, and transaction audit log.
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgepay
DB_PASSWORD=devpassword
DB_NAME=forgepay
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOG_SLOW_MS=500

# EVM RPC endpoints (use Infura, Alchemy, or self-hosted nodes)
RPC_URL_ETHEREUM=
RPC_URL_POLYGON=
RPC_URL_BASE=
RPC_URL_ARBITRUM=

# Ondo Finance institutional API
ONDO_API_KEY=

# Internal service URLs
STABLECOIN_GATEWAY_URL=http://localhost:3002

# Auto-sweep cron interval (default: 15 minutes)
SWEEP_INTERVAL_MINUTES=15

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Signing wallet private key (used to submit on-chain transactions)
# In production: use KMS / Vault, never a raw key
SIGNER_PRIVATE_KEY=
