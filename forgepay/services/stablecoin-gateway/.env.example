# Stablecoin Gateway — USDC/USDT deposits and transfers (EVM chains)
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Manages stablecoin deposits, withdrawals, and x402 micropayments.
# Generates ephemeral deposit addresses, verifies on-chain payments, enforces privacy via shielding.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# ── PostgreSQL Database ────────────────────────────────────────────────────────────
# Stores deposit addresses, payment records, transaction audit log.
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgepay
DB_PASSWORD=devpassword
DB_NAME=forgepay_dev
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOG_SLOW_MS=500

# ── Redis ──────────────────────────────────────────────────────────────────────────
# Caches ephemeral deposit addresses and payment tracking.
REDIS_URL=redis://localhost:6379

# ── Unified Router ─────────────────────────────────────────────────────────────────
# URL to unified-router for event forwarding (payments, deposits, transfers).
UNIFIED_ROUTER_URL=http://unified-router:8000

# ── Internal Webhook Secret ────────────────────────────────────────────────────────
# HMAC-SHA256 secret for outgoing webhooks to unified-router.
INTERNAL_WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# ── Block Confirmations (Risk Tolerance) ───────────────────────────────────────────
# Number of block confirmations required to consider a payment final.
# Higher = more secure but slower. Adjust per chain consensus characteristics.
ETH_CONFIRMATIONS=12
POLYGON_CONFIRMATIONS=20
BASE_CONFIRMATIONS=10
ARBITRUM_CONFIRMATIONS=10
SOLANA_CONFIRMATIONS=32

# ── RPC Endpoints (EVM Chains) ─────────────────────────────────────────────────────
# Public/private RPCs for Ethereum, Polygon, Base, Arbitrum.
# Use Alchemy, Infura, or QuickNode for reliability; fallback to public RPCs for dev.
ETH_RPC_URL=https://cloudflare-eth.com
POLYGON_RPC_URL=https://polygon-rpc.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for stablecoin API.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# ── x402 Payment Protocol (AI/Agent Payments) ──────────────────────────────────────
# Enable x402 HTTP 402-style micropayments (AI service access control).
X402_ENABLED=true
# Maximum stablecoin amount per x402 request (USD). Prevents runaway micro-charges.
X402_MAX_AMOUNT_USDC=100

# ── Deposit Address Management ──────────────────────────────────────────────────────
# TTL (seconds) for ephemeral deposit addresses. Default 48 hours.
# After expiry, address can be reused for new deposits.
DEPOSIT_ADDRESS_TTL=172800

# ── Payment Expiry ─────────────────────────────────────────────────────────────────
# Payment window (seconds). User must send payment within this time. Default 1 hour.
PAYMENT_EXPIRY_SECONDS=3600

# ── Shielded Stablecoin Payments (Privacy-Preserving) ────────────────────────────
# Master switch for the shielded-deposits and /x402/shielded-pay HTTP routes.
# DEFAULT: false — routes are NOT registered at all (404) when unset/false.
#
# WARNING: verifyGroth16Proof() in src/lib/proof-verifier.ts is currently a
# STUB. Whenever the NullifierRegistry contract for a chain is undeployed
# (all-zero address, see below), it returns true for ANY proof bytes instead
# of actually verifying them. Setting SHIELDED_PAYMENTS_ENABLED=true before
# NullifierRegistry contracts are deployed on every chain means anyone can
# POST a shielded deposit with garbage proof bytes and have it accepted and
# persisted with status='pending'.
#   - In NODE_ENV=production, the service now refuses to boot at all if you
#     set this to true while any chain's registry is still undeployed (see
#     assertShieldedPaymentsSafeToBoot() in src/lib/proof-verifier.ts).
#   - In dev/test, the stub still works (for local testing), but logs a
#     "STUB: ... BYPASSING real verification" warning on every call.
# Only enable this once real Groth16 verification is wired up to deployed
# NullifierRegistry contracts on every chain you intend to accept.
SHIELDED_PAYMENTS_ENABLED=false

# Enables the background monitor that polls NullifierRegistry contracts for
# confirmations of shielded deposits that were already created via the
# routes above. Independent of SHIELDED_PAYMENTS_ENABLED — there is nothing
# for this monitor to confirm if the routes are disabled and no shielded
# deposits are ever created.
SHIELDED_ENABLED=false

# Poll interval (ms) for checking NullifierRegistry on-chain for shielded payments.
SHIELDED_MONITOR_INTERVAL_MS=30000

# URL to MoR auditor service for decrypting encrypted transaction memos.
AUDITOR_SERVICE_URL=http://mor-layer:8010

# ── NullifierRegistry Smart Contract Addresses ────────────────────────────────────
# Deployed on each chain to track shielded payment commitments.
# Use 0x0000...0000 as placeholder until contract deployed.
NULLIFIER_REGISTRY_ETHEREUM=0x0000000000000000000000000000000000000000
NULLIFIER_REGISTRY_POLYGON=0x0000000000000000000000000000000000000000
NULLIFIER_REGISTRY_BASE=0x0000000000000000000000000000000000000000
NULLIFIER_REGISTRY_ARBITRUM=0x0000000000000000000000000000000000000000

# ── Private Key Encryption (dev only) ──────────────────────────────────────────────
# Encryption key for storing ephemeral private keys in the database.
# MUST be in Vault in production. Rotate regularly.
# PRIVATE_KEY_ENCRYPTION_KEY=your-encryption-key-min-32-chars

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for deposit tracking and payment verification.
# ENABLE_AUDIT_LOG=true
