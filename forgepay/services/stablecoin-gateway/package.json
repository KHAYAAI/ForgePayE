{
  "name": "@forgepay/stablecoin-gateway",
  "version": "0.1.0",
  "description": "ForgePay stablecoin payment gateway — USDC/USDT on EVM chains + Solana + x402",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/cors": "^10.0.1",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.3.2",
    "pg": "^8.12.0",
    "ethers": "^6.12.1",
    "uuid": "^10.0.0",
    "pino": "^9.2.0",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.5.3",
    "tsx": "^4.16.0",
    "pino-pretty": "^11.2.1",
    "vitest": "^1.6.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.14.1"
  }
}
