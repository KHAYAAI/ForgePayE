# Accounts Service — Stablecoin-Backed USD/USDC Accounts
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Manages USD/USDC wallets, deposits, withdrawals, and KYC/AML compliance.
# Provides merchant account ledger and reconciliation.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3003
LOG_LEVEL=info

# ── PostgreSQL Database ────────────────────────────────────────────────────────────
# Stores account ledgers, transaction history, KYC/AML status.
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgepay
DB_PASSWORD=devpassword
DB_NAME=forgepay
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOG_SLOW_MS=500

# ── Redis ──────────────────────────────────────────────────────────────────────────
# Caches account balances and rate limiting.
REDIS_URL=redis://localhost:6379

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute.
RATE_LIMIT_PER_MIN=100

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── KYC/AML Compliance ────────────────────────────────────────────────────────────
# KYAPay integration for identity verification.
KYAPAY_BASE_URL=https://api.kyapay.io
KYAPAY_API_KEY=
KYAPAY_API_SECRET=

# ── AWS KMS (for key encryption) ───────────────────────────────────────────────────
# Optional: use AWS KMS for encrypting stored API keys and credentials.
# AWS_REGION=us-east-1
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:ACCOUNT:key/KEY_ID
