# Crypto Gateway — Bitcoin, Monero, and cross-chain crypto payments
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Manages BTC, XMR, and multi-chain crypto deposits/withdrawals.
# Generates HD wallet addresses, verifies confirmations, handles privacy (Monero), bridge routing.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── PostgreSQL Database ────────────────────────────────────────────────────────────
# Stores HD wallet state, deposit addresses, payment records, audit log.
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgepay
DB_PASSWORD=devpassword
DB_NAME=forgepay_dev
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOG_SLOW_MS=500

# ── Redis ──────────────────────────────────────────────────────────────────────────
# Caches HD wallet addresses and payment tracking.
REDIS_URL=redis://localhost:6379

# ── Unified Router ─────────────────────────────────────────────────────────────────
# URL to unified-router for event forwarding (crypto deposits, withdrawals, transfers).
UNIFIED_ROUTER_URL=http://unified-router:8000

# ── Internal Webhook Secret ────────────────────────────────────────────────────────
# HMAC-SHA256 secret for outgoing webhooks to unified-router.
INTERNAL_WEBHOOK_SECRET=your-webhook-secret-min-32-chars

# ── HD Wallet Seed (CRITICAL SECRET) ───────────────────────────────────────────────
# BIP-39 seed for deriving unlimited deposit addresses (in hex).
# NEVER commit. Load from Vault at startup.
# To generate: openssl rand -hex 32
# HD_WALLET_SEED=your-bip39-seed-hex-64-chars

# ── HD Wallet Derivation Path ──────────────────────────────────────────────────────
# BIP-44 derivation path for address generation. Default for BTC: m/44'/0'/0'/0
# Customize per coin (e.g., m/44'/60'/0'/0 for Ethereum).
# HD_WALLET_PATH=m/44'/0'/0'/0

# ── Bitcoin ────────────────────────────────────────────────────────────────────────
# Bitcoin Core RPC endpoint (or btcd).
BTC_RPC_URL=http://localhost:18332
# Bitcoin RPC credentials (if required).
# BTC_RPC_USER=bitcoin
# BTC_RPC_PASSWORD=

# Confirmations required for BTC payment finality.
BTC_CONFIRMATIONS=6
# Network: 'mainnet', 'testnet', 'regtest'.
BTC_NETWORK=testnet

# ── Monero (Privacy Coin) ──────────────────────────────────────────────────────────
# Monero node RPC endpoint.
XMR_RPC_URL=http://localhost:18081
# Subaddress index for deposit tracking (enables change address separation).
XMR_SUBADDRESS_INDEX=0
# Confirmations for XMR payment finality.
XMR_CONFIRMATIONS=10
# Network: 'mainnet', 'stagenet', 'testnet'.
XMR_NETWORK=testnet

# ── EVM/Bridge Chains ──────────────────────────────────────────────────────────────
# Polygon for cross-chain bridge routing.
POLYGON_RPC_URL=https://polygon-rpc.com
# Arbitrum for cross-chain settlement.
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# ── Block Confirmations (Risk Tolerance) ───────────────────────────────────────────
# Number of block confirmations before considering payment final.
# BTC (testnet): 1-6 blocks. ETH: 12+ blocks. XMR: 10+ blocks.
ETH_CONFIRMATIONS=12
POLYGON_CONFIRMATIONS=20
ARBITRUM_CONFIRMATIONS=10

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# ── Payment Expiry ─────────────────────────────────────────────────────────────────
# Payment window (seconds). User must send payment within this time. Default 1 hour.
PAYMENT_EXPIRY_SECONDS=3600

# ── Exchange Rate Provider ───────────────────────────────────────────────────────────
# API key for real-time crypto/fiat exchange rates (CoinGecko, Kraken, etc.).
# Used to validate BTC/XMR → USD conversion before accepting deposits.
# EXCHANGE_RATE_API_KEY=your-api-key
# EXCHANGE_RATE_ENDPOINT=https://api.coingecko.com/api/v3

# ── Risk Controls ──────────────────────────────────────────────────────────────────
# Maximum single deposit in BTC (prevents fat-finger mistakes).
# MAX_BTC_DEPOSIT=10.0

# Maximum single deposit in XMR (privacy limit).
# MAX_XMR_DEPOSIT=100.0

# ── Private Key Encryption (dev only) ──────────────────────────────────────────────
# Encryption key for storing HD wallet seeds and private keys in database.
# MUST be in Vault in production. Rotate regularly.
# PRIVATE_KEY_ENCRYPTION_KEY=your-encryption-key-min-32-chars

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for HD wallet operations and transaction tracking.
# ENABLE_AUDIT_LOG=true
