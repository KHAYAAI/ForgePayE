{
  "name": "@forgepay/crypto-gateway",
  "version": "0.1.0",
  "description": "ForgePay crypto payment gateway — BTC, ETH, LTC, XMR invoice-based payments",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev":        "tsx watch src/index.ts",
    "build":      "tsc",
    "start":      "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint":       "eslint src",
    "test":       "vitest run"
  },
  "dependencies": {
    "fastify":           "^4.27.0",
    "@fastify/helmet":   "^11.1.1",
    "ioredis":           "^5.3.2",
    "pg":                "^8.12.0",
    "uuid":              "^10.0.0",
    "pino":              "^9.2.0",
    "bitcoinjs-lib":     "^6.1.5",
    "tiny-secp256k1":    "^2.2.3"
  },
  "devDependencies": {
    "@types/node":          "^20.14.0",
    "@types/pg":            "^8.11.6",
    "@types/uuid":          "^10.0.0",
    "@types/bitcoinjs-lib": "^5.0.3",
    "typescript":           "^5.5.3",
    "tsx":                  "^4.16.0",
    "vitest":               "^1.6.0",
    "eslint":               "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser":        "^7.14.1"
  }
}
