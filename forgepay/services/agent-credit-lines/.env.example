# Agent Credit Lines — Dynamic lending to payment agents
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Manages floating credit lines for autonomous payment agents,
# implements risk controls, and triggers liquidation if collateral falls below threshold.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3016
LOG_LEVEL=info

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute. Protects against abuse of credit allocation.
RATE_LIMIT_PER_MIN=100

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────────
# Stores agent credit facilities, drawdown history, collateral tracking.
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgepay
DB_PASSWORD=devpassword
DB_NAME=forgepay
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOG_SLOW_MS=500

# ── Credit Policy ──────────────────────────────────────────────────────────────────
# Maximum credit line size per agent (USD equivalent).
MAX_CREDIT_LINE_USD=100000

# Minimum collateral ratio to maintain (e.g., 1.5 = agent must hold 150% collateral).
MIN_COLLATERAL_RATIO=1.5

# Grace period (hours) before agent collateral deficit triggers liquidation.
LIQUIDATION_GRACE_PERIOD_HOURS=24

# Daily drawdown limit per agent (USD). Prevents runaway credit exposure.
MAX_DAILY_DRAWDOWN_USD=25000

# ── Risk Assessment ────────────────────────────────────────────────────────────────
# API endpoint for agent identity/credit score verification.
AGENT_IDENTITY_URL=http://localhost:3010

# Minimum credit score (0-100) to qualify for credit line.
MIN_CREDIT_SCORE=40

# ── Collateral Chains ─────────────────────────────────────────────────────────────
# Blockchain RPC endpoints for checking collateral balances.
# ETH_RPC_URL=https://cloudflare-eth.com
# POLYGON_RPC_URL=https://polygon-rpc.com

# ── Interest / Fees ────────────────────────────────────────────────────────────────
# Annual percentage rate (APR) charged on outstanding credit line balances.
APR_PERCENT=8.0

# Origination fee (%) charged when credit line is established.
ORIGINATION_FEE_PERCENT=1.0

# ── Webhooks ───────────────────────────────────────────────────────────────────────
# Internal secret for receiving compliance/risk signals from compliance-monitor.
INTERNAL_WEBHOOK_SECRET=your-webhook-secret

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for credit drawdowns and liquidations.
# ENABLE_AUDIT_LOG=true
