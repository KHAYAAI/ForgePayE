{
  "name": "@forgepay/bank-connectivity",
  "version": "0.1.0",
  "private": true,
  "description": "ForgePay bank account connectivity service — Plaid (US) and Open Banking (EU/UK) adapter with ACH/SEPA transfer initiation",
  "scripts": {
    "dev":        "tsx watch src/index.ts",
    "build":      "tsc -p tsconfig.json",
    "start":      "node dist/index.js",
    "lint":       "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test":       "vitest run"
  },
  "dependencies": {
    "fastify":             "^4.28.0",
    "@fastify/helmet":     "^11.1.1",
    "@fastify/cors":       "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/jwt":        "^8.0.1",
    "@fastify/sensible":   "^5.6.0",
    "@prisma/client":      "^5.17.0",
    "plaid":               "^25.0.0",
    "axios":               "^1.7.4",
    "zod":                 "^3.23.8",
    "pino":                "^9.3.2",
    "pino-pretty":         "^11.2.1",
    "dotenv":              "^16.4.5",
    "uuid":                "^10.0.0"
  },
  "devDependencies": {
    "@types/node":  "^20.14.0",
    "@types/uuid":  "^10.0.0",
    "typescript":   "^5.5.3",
    "tsx":          "^4.16.2",
    "vitest":       "^2.0.4"
  }
}
