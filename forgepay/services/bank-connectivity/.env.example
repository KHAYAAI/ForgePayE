# Bank Connectivity — Plaid/OpenBanking integration for bank account linking
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript) with Prisma ORM. Manages bank account linking and transfers.

# ── Server ─────────────────────────────────────────────────────────────────────────
PORT=3006
NODE_ENV=development
LOG_LEVEL=info

# ── PostgreSQL Database (via Prisma) ──────────────────────────────────────────────
# Connection string for Prisma ORM. Can use individual DB_* vars or a full URL.
# Prisma respects DATABASE_URL environment variable or constructs from DB_* vars.
DB_HOST=localhost
DB_PORT=5432
DB_USER=forgepay
DB_PASSWORD=devpassword
DB_NAME=forgepay
DB_POOL_MAX=20
DB_POOL_MIN=2
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOG_SLOW_MS=500

# ── Authentication ─────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Plaid Integration ──────────────────────────────────────────────────────────────
# Bank account linking via Plaid API.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── OpenBanking Integration ────────────────────────────────────────────────────────
# Alternative bank connectivity provider.
OB_BASE_URL=
OB_CLIENT_ID=
OB_CLIENT_SECRET=

# ── Encryption ─────────────────────────────────────────────────────────────────────
# AES-256 encryption key for storing bank tokens and credentials.
ENCRYPTION_KEY=

# ── CORS Origins ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
