# Institutional Reporting — Analytics and regulatory reporting for institutions
# ═══════════════════════════════════════════════════════════════════════════════════
# Fastify (TypeScript). Aggregates financial data from all ForgePay services and
# generates reports for institutions, regulators, and audit compliance.

# ── Server ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3017
LOG_LEVEL=info

# ── Enterprise Treasury Service ────────────────────────────────────────────────────
# URL to enterprise-treasury for cash flow, balance sheet, and FX data.
TREASURY_URL=http://localhost:3012

# ── Yield Engine Service ────────────────────────────────────────────────────────────
# URL to yield-engine for earnings, APY, and yield farming data.
YIELD_ENGINE_URL=http://localhost:3007

# ── Bank Whitelabel Service ────────────────────────────────────────────────────────
# URL to bank-whitelabel for institutional account activity and settlement data.
BANK_WHITELABEL_URL=http://localhost:3015

# ── Rate Limiting ──────────────────────────────────────────────────────────────────
# Maximum API requests per minute. Reporting endpoints handle intensive queries.
RATE_LIMIT_PER_MIN=60

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (typically internal dashboards).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────────
# Stores cached reports, drill-down data, audit trails.
# DATABASE_URL=postgresql://forgepay:password@localhost:5432/reporting

# ── Report Configuration ──────────────────────────────────────────────────────────
# Report generation interval (minutes). How often to run batch report generation.
REPORT_GENERATION_INTERVAL_MINUTES=15

# Retention period for historical reports (days). Default 2 years = 730 days.
REPORT_RETENTION_DAYS=730

# ── Regulatory Reporting ──────────────────────────────────────────────────────────
# Jurisdiction for regulatory reporting. E.g., 'us' (SEC), 'eu' (EBA), 'uk' (FCA).
REGULATORY_JURISDICTION=us

# File format for generated regulatory reports. Options: 'csv', 'json', 'xml', 'pdf'.
REPORT_FORMAT=csv

# ── Audit Trail ────────────────────────────────────────────────────────────────────
# Enable comprehensive audit logging for all report access and modifications.
ENABLE_AUDIT_LOG=true

# Maximum audit log retention (days) before archival.
AUDIT_LOG_RETENTION_DAYS=365

# ── Tax Reporting ──────────────────────────────────────────────────────────────────
# Enable tax reporting module for 1099, 1040, etc.
ENABLE_TAX_REPORTING=true

# Tax reporting threshold (USD). Only transactions above this are reported.
TAX_REPORTING_THRESHOLD_USD=600

# ── KYC/AML Reporting ─────────────────────────────────────────────────────────────
# URL to compliance-monitor for regulatory reporting data (CTRs, SARs, etc.).
# COMPLIANCE_SERVICE_URL=http://localhost:8003

# ── Data Export ────────────────────────────────────────────────────────────────────
# Enable data export APIs for institutional customers (BigQuery, Snowflake, etc.).
ENABLE_DATA_EXPORT=true

# Comma-separated list of allowed export destinations.
# E.g., 's3://my-bucket,bigquery://my-project.dataset'
# EXPORT_DESTINATIONS=

# ── Cache (Redis) ──────────────────────────────────────────────────────────────────
# Redis URL for caching report data (avoid re-computing on repeated queries).
# REDIS_URL=redis://localhost:6379

# Cache TTL (minutes) for report data.
# REPORT_CACHE_TTL_MINUTES=60

# ── Dashboard Integration ──────────────────────────────────────────────────────────
# Enable real-time dashboard updates (WebSocket).
# ENABLE_DASHBOARD_WEBSOCKET=true

# ── Observability ──────────────────────────────────────────────────────────────────
# Enable detailed logging for report generation, data aggregation.
# ENABLE_AUDIT_LOG=true

# Enable tracing for slow report queries (debug performance issues).
# ENABLE_TRACE_LOGGING=false
