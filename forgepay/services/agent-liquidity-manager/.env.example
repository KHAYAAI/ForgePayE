# Agent Liquidity Manager — Environment Variables
# Copy to .env and fill in required values before running.
# Required values are marked with: # Required

# Server
PORT=3012
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_PER_MIN=200

# Upstream Services
AGENT_IDENTITY_URL=http://agent-identity:3010
STABLECOIN_GATEWAY_URL=http://stablecoin-gateway:8020
CRYPTO_GATEWAY_URL=http://crypto-gateway:8030

# Liquidity Management
REBALANCE_THRESHOLD_USD=100
REBALANCE_INTERVAL_MS=60000
MIN_RESERVE_USD=50

# Authentication
# Operator/service key — required in production, refuses to boot without it
# (or with the dev placeholder / a value under 32 chars). Generate with
# `openssl rand -hex 32` and inject from Vault / AWS Secrets Manager.
# Per-agent keys are minted at runtime via POST /v1/agents/:agentId/api-key
# (admin-only) and are not configured here.
ALM_ADMIN_API_KEY=your-admin-api-key-here # Required in production
