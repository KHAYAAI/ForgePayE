# Environment for ONE signing node in production. Copy to the node's own host
# and fill in; never share this file between nodes.
MPC_ENV=production

# Seal key: wrapped by Vault transit (or set MPC_SEAL_PROVIDER=awskms + MPC_KMS_KEY_ID + AWS_REGION).
MPC_SEAL_PROVIDER=vault
VAULT_ADDR=https://vault.node1.internal:8200
# Prefer AppRole with a narrowly scoped policy (transit encrypt/decrypt/rewrap on this node's key only).
VAULT_ROLE_ID=
VAULT_SECRET_ID=
MPC_VAULT_KEY=mpc-node-node1
# VAULT_CACERT=/etc/mpc/vault-ca.pem
# VAULT_NAMESPACE=

# Mutual TLS: this node's certificate (CN must equal the node id) and the cluster CA.
MPC_TLS_CA_FILE=/etc/mpc/tls/ca.pem
MPC_TLS_CERT_FILE=/etc/mpc/tls/cert.pem
MPC_TLS_KEY_FILE=/etc/mpc/tls/key.pem

# This node's own signing policy, owned by whoever operates THIS node.
MPC_NODE_POLICY_FILE=/etc/mpc/policy.json
