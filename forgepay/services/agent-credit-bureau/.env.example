PORT=3018
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=*
RATE_LIMIT_PER_MIN=100
AGENT_IDENTITY_URL=http://localhost:3010

# ── Persistence (optional) ──────────────────────────────────────────────
# When DATABASE_URL or DB_HOST is set, the bureau migrates + hydrates from
# Postgres and write-throughs every mutation. Unset → in-memory demo mode.
# DATABASE_URL=postgres://forgepay:forgepay@localhost:5432/forgepay
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=forgepay
DB_POOL_MAX=20
DB_POOL_MIN=2
