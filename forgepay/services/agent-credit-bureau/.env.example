PORT=3018
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=*
RATE_LIMIT_PER_MIN=100
AGENT_IDENTITY_URL=http://localhost:3010

# ── Persistence (optional) ──────────────────────────────────────────────
# When DATABASE_URL or DB_HOST is set, the bureau migrates + hydrates from
# Postgres and write-throughs every mutation. Unset → in-memory demo mode.
# DATABASE_URL=postgres://forgepay:forgepay@localhost:5432/forgepay
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=forgepay
DB_POOL_MAX=20
DB_POOL_MIN=2

# ── Authentication ────────────────────────────────────────────────────────────
# Operator/admin API key. Grants every scope: contributor registration and
# activation, dispute resolution, settlement.
#
# REQUIRED IN PRODUCTION — the service refuses to boot without it, and rejects
# both the development value below and anything shorter than 32 characters.
#   openssl rand -hex 32
BUREAU_ADMIN_API_KEY=dev-bureau-admin-key

# Development furnisher keys for the three seeded contributors. Only their
# sha256 digests are stored; these raw values exist solely so the demo
# furnishers can authenticate locally.
#   contrib_aave      ck_aave_live_xxx       (ingest_events, pull_scores)
#   contrib_compound  ck_compound_live_yyy   (ingest_events)
#   contrib_openai    ck_oai_live_zzz        (ingest_events, pull_scores)

# Signs consent tokens — the evidence that an agent authorised a credit pull.
# REQUIRED IN PRODUCTION: the service refuses to issue or verify consent with
# the development value below, or with fewer than 32 characters.
#   openssl rand -hex 32
CONSENT_SIGNING_SECRET=dev-consent-signing-secret

# ── Sanctions screening (compliance-monitor service) ───────────────────────────
# When unset, sanctionsScreen()'s address/entity checks are SKIPPED WITH A
# LOGGED WARNING in development and FAIL CLOSED in production — set this
# before launch.
#COMPLIANCE_MONITOR_URL=http://compliance-monitor:8004
# API key sent as X-Compliance-API-Key. Required if compliance-monitor has
# REQUIRE_AUTH enabled (see that service's own .env.example).
#COMPLIANCE_MONITOR_API_KEY=
