# MoR Layer — Merchant-of-Record tax and checkout service
# ═══════════════════════════════════════════════════════════════════════════════════
# Polars fork (FastAPI). Handles MoR tax calculation, tax jurisdiction detection,
# checkout page rendering, invoice generation, subscription management.
#
# Privacy: Auditor service decrypts shielded transaction memos with X25519 ECDH + AES-GCM.

# ── Server ─────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8010
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────────
# PostgreSQL + asyncpg (async driver). Stores invoices, tax jurisdictions, audit log.
MOR_DATABASE_URL=postgresql+asyncpg://forgepay:devpassword@localhost:5432/forgepay_dev

# ── Redis ──────────────────────────────────────────────────────────────────────────
# Caches tax rates, jurisdiction rules, session storage.
REDIS_URL=redis://localhost:6379

# ── Internal Webhook Secret ────────────────────────────────────────────────────────
# HMAC-SHA256 secret for verifying webhooks from unified-router and billing-engine.
INTERNAL_WEBHOOK_SECRET=dev-internal-secret-change-me

# ── Auditor Service (ZK Privacy) ───────────────────────────────────────────────────
# Enable ZK proof verification for shielded stablecoin transactions.
ZK_PROOF_VERIFICATION_ENABLED=false
# URL of the ZK sidecar service (Circom/Noir prover).
ZK_SIDECAR_URL=http://localhost:8090

# ── CORS Origins ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for checkout page and API calls.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ── Tax Configuration ──────────────────────────────────────────────────────────────
# Default tax rates per jurisdiction (country code).
# Format: COUNTRY_CODE=tax_rate_percent (e.g., US=8.5)
# Override individual rates here; fallback to database defaults.
# TAX_RATE_US=8.5
# TAX_RATE_CA=5.0
# TAX_RATE_EU_VAT=19.0

# ── Subscription Handling ──────────────────────────────────────────────────────────
# Day of month to attempt subscription billing (1-28). E.g., 1 = 1st of month.
SUBSCRIPTION_BILLING_DAY=1
# Invoice grace period (days) before payment is overdue and dunning begins.
INVOICE_DUE_GRACE_DAYS=14

# ── Checkout Page ──────────────────────────────────────────────────────────────────
# Session TTL (minutes) for checkout page. User must complete payment within this window.
CHECKOUT_SESSION_TTL_MINUTES=30
# Where to redirect after successful payment. E.g., merchant's order confirmation page.
CHECKOUT_SUCCESS_REDIRECT_BASE=https://example.com/checkout/success

# ── Documentation (FastAPI) ────────────────────────────────────────────────────────
# Expose Swagger /docs in non-production environments only.
# Set to true in dev/staging for API exploration. False in production.
EXPOSE_DOCS=true
