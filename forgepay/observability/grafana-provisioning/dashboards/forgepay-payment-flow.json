{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "barchart", "name": "Bar chart", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "End-to-end payment flow monitoring: success rates by rail, volume, checkout sessions, webhook delivery, and crypto confirmation times.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": ["forgepay"],
      "targetBlank": false,
      "title": "ForgePay Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Payment Success Rates by Rail",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"mor-layer\", status_code=~\"2..\"}[5m])) / sum(rate(http_requests_total{service=\"mor-layer\"}[5m]))",
          "legendFormat": "Card Success Rate",
          "refId": "A"
        }
      ],
      "title": "Card Payment Success Rate",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(rate(stablecoin_transfer_duration_seconds_count{status=\"success\"}[5m])) / sum(rate(stablecoin_transfer_duration_seconds_count[5m]))",
          "legendFormat": "Stablecoin Success Rate",
          "refId": "A"
        }
      ],
      "title": "Stablecoin Payment Success Rate",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.90 },
              { "color": "green", "value": 0.98 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(rate(crypto_payment_creation_duration_seconds_count{status=\"success\"}[5m])) / sum(rate(crypto_payment_creation_duration_seconds_count[5m]))",
          "legendFormat": "Crypto Success Rate",
          "refId": "A"
        }
      ],
      "title": "Crypto Payment Success Rate",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.99 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "sum(rate(transfer_initiation_duration_seconds_count{status=\"initiated\"}[5m])) / sum(rate(transfer_initiation_duration_seconds_count[5m]))",
          "legendFormat": "Bank Transfer Success Rate",
          "refId": "A"
        }
      ],
      "title": "Bank Transfer Success Rate",
      "type": "gauge"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "id": 101,
      "title": "Payment Volume",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 8 },
      "id": 5,
      "options": {
        "barWidth": 0.97,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom" },
        "orientation": "auto",
        "stacking": "none",
        "tooltip": { "mode": "multi" },
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0
      },
      "targets": [
        {
          "expr": "sum(increase(http_requests_total{service=\"mor-layer\", status_code=~\"2..\"}[1h]))",
          "legendFormat": "Card (mor-layer)",
          "refId": "A"
        },
        {
          "expr": "sum(increase(stablecoin_transfer_duration_seconds_count{status=\"success\"}[1h]))",
          "legendFormat": "Stablecoin",
          "refId": "B"
        },
        {
          "expr": "sum(increase(crypto_payment_creation_duration_seconds_count{status=\"success\"}[1h]))",
          "legendFormat": "Crypto",
          "refId": "C"
        },
        {
          "expr": "sum(increase(transfer_initiation_duration_seconds_count{status=\"initiated\"}[1h]))",
          "legendFormat": "Bank Transfer",
          "refId": "D"
        }
      ],
      "title": "Payment Volume by Rail (per hour)",
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "id": 6,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(swept_balances_total) + sum(yield_earned_total)",
          "legendFormat": "Revenue Processed (USD)",
          "refId": "A"
        }
      ],
      "title": "Revenue Processed (USD) — Running Total",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 102,
      "title": "Checkout & Webhook",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 17 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(checkout_duration_seconds_count[2m]))",
          "legendFormat": "Checkout Session Creation Rate",
          "refId": "A"
        },
        {
          "expr": "sum(rate(checkout_duration_seconds_count{status=\"success\"}[2m]))",
          "legendFormat": "Successful Checkouts",
          "refId": "B"
        }
      ],
      "title": "Checkout Session Creation Rate (mor-layer)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 17 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "min"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "sum(rate(webhook_dedup_misses_total[5m])) / (sum(rate(webhook_dedup_misses_total[5m])) + sum(rate(webhook_normalization_errors_total[5m])))",
          "legendFormat": "Webhook Delivery Success Rate",
          "refId": "A"
        }
      ],
      "title": "Webhook Delivery Success Rate (unified-router)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 },
      "id": 103,
      "title": "Crypto Confirmation & Failures",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 25 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (coin, le) (rate(crypto_payment_creation_duration_seconds_bucket[5m])))",
          "legendFormat": "P50 {{ coin }}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (coin, le) (rate(crypto_payment_creation_duration_seconds_bucket[5m])))",
          "legendFormat": "P95 {{ coin }}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (coin, le) (rate(crypto_payment_creation_duration_seconds_bucket[5m])))",
          "legendFormat": "P99 {{ coin }}",
          "refId": "C"
        }
      ],
      "title": "Avg Payment Confirmation Time by Coin (crypto-gateway)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {}
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 25 },
      "id": 10,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "right" },
        "pieType": "pie",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "expr": "sum by (error_reason) (increase(checkout_errors_total[1h]))",
          "legendFormat": "{{ error_reason }}",
          "refId": "A"
        }
      ],
      "title": "Failed Payments by Reason (last 1h)",
      "type": "piechart"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["forgepay", "payments", "flow"],
  "templating": { "list": [] },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ForgePay — Payment Flow",
  "uid": "forgepay-payment-flow",
  "version": 1
}
