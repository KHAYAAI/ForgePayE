{
  "compilerOptions": {
    "target":            "ES2020",
    "lib":               ["ES2020"],
    "module":            "ESNext",
    "moduleResolution":  "bundler",
    "declaration":       true,
    "declarationMap":    true,
    "sourceMap":         true,
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "noUncheckedIndexedAccess": true,
    "outDir":            "dist/esm",
    "declarationDir":    "dist/types",
    "rootDir":           "src"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
