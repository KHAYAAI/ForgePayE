{
  "DistributionConfig": {
    "CallerReference": "forge-website-" + Date.now(),
    "Comment": "FORGE website distribution",
    "DefaultRootObject": "index.html",
    "Origins": {
      "Quantity": 1,
      "Items": [
        {
          "Id": "forge-s3-origin",
          "DomainName": "forge-website-prod.s3.us-east-1.amazonaws.com",
          "S3OriginConfig": {
            "OriginAccessIdentity": ""
          }
        }
      ]
    },
    "DefaultCacheBehavior": {
      "AllowedMethods": {
        "Quantity": 3,
        "Items": ["GET", "HEAD", "OPTIONS"]
      },
      "CachePolicyId": "658327ea-f89d-4fab-a63d-7e88639e58f6",
      "Compress": true,
      "TargetOriginId": "forge-s3-origin",
      "ViewerProtocolPolicy": "https-only"
    },
    "CacheBehaviors": [
      {
        "PathPattern": "*.html",
        "AllowedMethods": {
          "Quantity": 3,
          "Items": ["GET", "HEAD", "OPTIONS"]
        },
        "CachePolicyId": "4135ea3d-c35d-46eb-81d7-edf4db3b95e9",
        "TargetOriginId": "forge-s3-origin",
        "ViewerProtocolPolicy": "https-only",
        "Compress": true
      }
    ],
    "Enabled": true,
    "HttpVersion": "http2and3",
    "PriceClass": "PriceClass_100",
    "ViewerCertificate": {
      "CloudFrontDefaultCertificate": true
    }
  }
}
