{
  "name": "@forgepay/on-chain",
  "version": "0.1.0",
  "description": "FORGE on-chain reputation contracts — forked and patched from Qova (MIT)",
  "private": true,
  "scripts": {
    "compile": "npx hardhat compile",
    "test:hh": "npx hardhat test",
    "clean": "npx hardhat clean",
    "forge:build": "forge build",
    "forge:test": "forge test -vv",
    "forge:test:gas": "forge test --gas-report",
    "forge:coverage": "forge coverage",
    "deploy:sepolia": "forge script script/Deploy.s.sol:Deploy --rpc-url $BASE_SEPOLIA_RPC_URL --private-key $SETTLEMENT_PRIVATE_KEY --broadcast --verify",
    "deploy:base": "forge script script/Deploy.s.sol:Deploy --rpc-url $BASE_MAINNET_RPC_URL --private-key $SETTLEMENT_PRIVATE_KEY --broadcast --verify"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@chainlink/contracts-ccip": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.28.6",
    "solc": "^0.8.35",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "license": "MIT",
  "attribution": "Contains code derived from Qova (https://github.com/brn-mwai/qova) by Hausor Labs — MIT License",
  "type": "module"
}
