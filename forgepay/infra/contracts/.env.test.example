# .env.test.example — local/CI contract-test config template
#
# Copy to .env.test and fill in real values. Never commit .env.test itself
# (see .gitignore). The previous .env.test held what appears to be a real,
# non-placeholder private key, committed in cleartext — it has been removed
# from tracking. That key must be treated as compromised: rotate it, and if
# it was ever funded or reused anywhere beyond disposable test deploys,
# check its transaction history. Removing the file from the current tree
# does not remove it from git history — the exposure isn't undone by this
# change alone.

ETHEREUM_TESTNET_RPC_URL=
# Use a disposable key generated for this purpose only.
DEPLOY_PRIVATE_KEY=
ETHERSCAN_API_KEY=
