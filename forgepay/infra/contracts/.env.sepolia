# Sepolia Testnet Deployment Configuration
# This file contains sensitive credentials. NEVER commit this to git.
# Use a password manager or .env.local for real deployment keys.

# Ethereum Sepolia RPC endpoint (choose one)
ETHEREUM_TESTNET_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# OR: ETHEREUM_TESTNET_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Deployer wallet private key (must have ~0.5 Sepolia ETH for gas)
DEPLOY_PRIVATE_KEY=0x

# Owner address for access control (defaults to deployer if not set)
# OWNER_ADDRESS=0x

# Auditor address (compliance enforcement, defaults to deployer if not set)
# AUDITOR_ADDRESS=0x

# Updater address (unified-router service account, defaults to deployer if not set)
# UPDATER_ADDRESS=0x

# Etherscan API key for contract verification (optional)
ETHERSCAN_API_KEY=
