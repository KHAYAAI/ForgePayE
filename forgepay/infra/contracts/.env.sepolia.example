# .env.sepolia.example — Sepolia testnet deployment config template
#
# Copy to .env.sepolia and fill in real values. Never commit .env.sepolia
# itself (see .gitignore). A sibling file, .env.test, was previously
# committed with what appears to be a real, non-placeholder private key —
# it has been removed from tracking. If you ever used that key for
# anything beyond a disposable testnet deploy, treat it as compromised and
# rotate it; removing the file from the current tree does not remove it
# from git history.

ETHEREUM_TESTNET_RPC_URL=
# Use a disposable key generated for this purpose only — never a key that
# also holds mainnet funds or controls anything real.
#   cast wallet new    (Foundry)   — or any wallet's "create new account"
DEPLOY_PRIVATE_KEY=
ETHERSCAN_API_KEY=
