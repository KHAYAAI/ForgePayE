{
  "name": "@forgepay/contracts",
  "version": "0.1.0",
  "description": "ForgePay on-chain contracts: Groth16Verifier, NullifierRegistry, CommitmentTree",
  "private": true,
  "scripts": {
    "compile":         "hardhat compile",
    "test":            "hardhat test",
    "coverage":        "hardhat coverage",
    "deploy:sepolia":  "hardhat run scripts/deploy.ts --network sepolia",
    "deploy:mumbai":   "hardhat run scripts/deploy.ts --network polygon-mumbai",
    "deploy:base-goerli": "hardhat run scripts/deploy.ts --network base-goerli",
    "deploy:arb-sepolia": "hardhat run scripts/deploy.ts --network arbitrum-sepolia",
    "deploy:mainnet":  "hardhat run scripts/deploy-mainnet.ts --network ethereum",
    "verify":          "hardhat run scripts/verify.ts",
    "update-addresses": "ts-node scripts/update-addresses.ts"
  },
  "devDependencies": {
    "hardhat":                            "^2.22.0",
    "@nomicfoundation/hardhat-toolbox":   "^5.0.0",
    "@nomicfoundation/hardhat-ethers":    "^3.0.0",
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@typechain/hardhat":                 "^9.1.0",
    "@typechain/ethers-v6":               "^0.5.0",
    "chai":                               "^4.4.1",
    "ethers":                             "^6.12.1",
    "typechain":                          "^8.3.2",
    "typescript":                         "^5.5.3",
    "@types/node":                        "^20.14.0",
    "@types/chai":                        "^4.3.16",
    "@types/mocha":                       "^10.0.7",
    "ts-node":                            "^10.9.2",
    "js-yaml":                            "^4.1.0",
    "@types/js-yaml":                     "^4.0.9"
  }
}
