# =============================================================================
# ForgePay Staging — Environment Variables Template
# =============================================================================
# Copy this file to .env.staging and fill in real values.
#
#   cp .env.staging.example .env.staging
#
# NEVER commit .env.staging to version control.
# All secrets should ultimately live in AWS Secrets Manager:
# see SECRETS_SETUP.md for the full secret creation guide.
#
# Format: KEY=value
# Placeholders use angle-bracket notation: <REPLACE_ME>
# Terraform output references use double underscores: __TF_OUTPUT_*
# (deploy-staging.sh substitutes these automatically)

# =============================================================================
# GLOBAL / SHARED
# =============================================================================

# AWS region being deployed to
AWS_REGION=af-south-1

# Environment name — used by all services for config branching
ENVIRONMENT=staging

# AWS account ID — used for ECR image paths and ARN construction
AWS_ACCOUNT_ID=<YOUR_AWS_ACCOUNT_ID>

# Internal service mesh base domain (Kubernetes cluster.local)
INTERNAL_DOMAIN=forgepay-staging.svc.cluster.local

# OTEL collector endpoint for all services
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.forgepay-staging.svc.cluster.local:4317
OTEL_SERVICE_NAMESPACE=forgepay-staging

# Staging image tag applied to all ECR images during deploy
IMAGE_TAG=staging

# =============================================================================
# DATABASE (RDS PostgreSQL)
# Injected from Terraform outputs by deploy-staging.sh
# =============================================================================

# PostgreSQL connection — host populated from TF output, rest set here
DATABASE_HOST=__TF_OUTPUT_rds_endpoint
DATABASE_PORT=5432
DATABASE_NAME=forgepay
DATABASE_USER=forgepay_staging
DATABASE_PASSWORD=<REPLACE_WITH_STRONG_PASSWORD>

# Full DATABASE_URL (constructed by deploy-staging.sh from the above)
# Used by Node.js / Python services that accept a connection string
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# Kill Bill uses its own database schema
KILLBILL_DATABASE_NAME=killbill
KILLBILL_DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${KILLBILL_DATABASE_NAME}

# =============================================================================
# REDIS (ElastiCache)
# Injected from Terraform outputs by deploy-staging.sh
# =============================================================================

REDIS_HOST=__TF_OUTPUT_redis_endpoint
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
# No password for staging single-node ElastiCache (within VPC, not public)
REDIS_PASSWORD=

# =============================================================================
# AUTH & SECURITY
# =============================================================================

# HS256 JWT signing secret (256-bit random hex)
# Generate: openssl rand -hex 32
JWT_SECRET=<REPLACE_WITH_64_CHAR_HEX_STRING>

# JWT token expiry
JWT_EXPIRY=3600          # 1 hour for staging
REFRESH_TOKEN_EXPIRY=86400  # 24 hours

# Internal webhook HMAC-SHA256 signing secret (for inter-service events)
# Generate: openssl rand -hex 32
INTERNAL_WEBHOOK_SECRET=<REPLACE_WITH_64_CHAR_HEX_STRING>

# Hyperswitch webhook verification secret
HYPERSWITCH_WEBHOOK_SECRET=<REPLACE_WITH_64_CHAR_HEX_STRING>

# AES-256 key for encrypting PII at rest in the database (32 bytes, base64)
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=<REPLACE_WITH_BASE64_AES_KEY>

# =============================================================================
# PAYMENT ENGINE (Hyperswitch) — port 80/443
# =============================================================================

# Master encryption key for Hyperswitch card vault (PCI requirement)
MASTER_ENC_KEY=<REPLACE_WITH_HYPERSWITCH_ENC_KEY>

# Hyperswitch admin API key (used for internal service-to-service calls)
HYPERSWITCH_ADMIN_API_KEY=<REPLACE_WITH_HYPERSWITCH_ADMIN_KEY>

# Hyperswitch base URL (internal k8s service name)
HYPERSWITCH_BASE_URL=http://payment-engine.${INTERNAL_DOMAIN}:80

# Connector credentials — use sandbox/test keys for staging
STRIPE_API_KEY=sk_test_<REPLACE_WITH_STRIPE_TEST_KEY>
STRIPE_WEBHOOK_SECRET=whsec_<REPLACE_WITH_STRIPE_TEST_WEBHOOK_SECRET>
ADYEN_API_KEY=<REPLACE_WITH_ADYEN_TEST_KEY>
ADYEN_MERCHANT_ACCOUNT=<REPLACE_WITH_ADYEN_TEST_MERCHANT>
ADYEN_ENVIRONMENT=test
BRAINTREE_MERCHANT_ID=<REPLACE_WITH_BRAINTREE_TEST_MERCHANT>
BRAINTREE_PUBLIC_KEY=<REPLACE_WITH_BRAINTREE_TEST_PUBLIC_KEY>
BRAINTREE_PRIVATE_KEY=<REPLACE_WITH_BRAINTREE_TEST_PRIVATE_KEY>
BRAINTREE_ENVIRONMENT=sandbox

# =============================================================================
# UNIFIED ROUTER — port 3000
# =============================================================================

PORT_UNIFIED_ROUTER=3000

# Downstream service URLs (internal k8s)
PAYMENT_ENGINE_URL=http://payment-engine.${INTERNAL_DOMAIN}:80
MOR_LAYER_URL=http://mor-layer.${INTERNAL_DOMAIN}:8000
BILLING_ENGINE_URL=http://billing-engine.${INTERNAL_DOMAIN}:8080
COMPLIANCE_MONITOR_URL=http://compliance-monitor.${INTERNAL_DOMAIN}:8001

# CORS — staging dashboard origin
CORS_ORIGIN=https://dashboard.staging.af.forgepay.io

# Webhook delivery retry config
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY_MS=5000

# =============================================================================
# MOR LAYER (Python FastAPI) — port 8000
# =============================================================================

PORT_MOR_LAYER=8000

# Stripe Tax API (sandbox)
STRIPE_TAX_API_KEY=sk_test_<REPLACE_WITH_STRIPE_TEST_KEY>

# VAT/GST rates mode: sandbox uses fixed test rates
TAX_RATES_MODE=sandbox

# MoR entity details (staging test entity)
MOR_ENTITY_NAME=ForgePay Staging Ltd
MOR_ENTITY_COUNTRY=ZA
MOR_ENTITY_VAT_ID=ZA_TEST_VAT_ID

# =============================================================================
# BILLING ENGINE (Kill Bill) — port 8080
# =============================================================================

PORT_BILLING_ENGINE=8080

# Kill Bill admin credentials (change from defaults for any shared staging)
KILLBILL_USER=admin
KILLBILL_PASSWORD=<REPLACE_WITH_KILLBILL_ADMIN_PASSWORD>
KILLBILL_API_KEY=forgepay_staging
KILLBILL_API_SECRET=<REPLACE_WITH_KILLBILL_API_SECRET>

# Kill Bill test mode (disables real payment calls)
KILLBILL_TEST_MODE=true

# =============================================================================
# STABLECOIN GATEWAY — port 3001
# =============================================================================

PORT_STABLECOIN_GATEWAY=3001

# Circle API (sandbox)
CIRCLE_API_KEY=<REPLACE_WITH_CIRCLE_SANDBOX_KEY>
CIRCLE_ENVIRONMENT=sandbox

# x402 payment protocol config
X402_USDC_CONTRACT_POLYGON=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174  # USDC on Polygon (testnet: Mumbai)
X402_USDT_CONTRACT_POLYGON=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# Polygon testnet RPC (Mumbai for staging)
POLYGON_RPC_URL=https://polygon-mumbai.g.alchemy.com/v2/<REPLACE_WITH_ALCHEMY_KEY>
ETHEREUM_RPC_URL=https://eth-goerli.g.alchemy.com/v2/<REPLACE_WITH_ALCHEMY_KEY>

# x402 facilitator wallet (testnet — fund with test MATIC/ETH)
X402_FACILITATOR_PRIVATE_KEY=<REPLACE_WITH_TESTNET_PRIVATE_KEY>
X402_FACILITATOR_ADDRESS=<REPLACE_WITH_TESTNET_WALLET_ADDRESS>

# =============================================================================
# CRYPTO GATEWAY (Keagate fork) — port 3002
# =============================================================================

PORT_CRYPTO_GATEWAY=3002

# Use testnet for staging
CRYPTO_GATEWAY_TESTNET=true

# Bitcoin testnet
BITCOIN_NETWORK=testnet
BITCOIN_NODE_URL=https://blockstream.info/testnet/api
BITCOIN_XPUB=<REPLACE_WITH_TESTNET_BITCOIN_XPUB>

# Ethereum testnet
ETHEREUM_NETWORK=goerli
WEB3_PROVIDER_URL=https://eth-goerli.g.alchemy.com/v2/<REPLACE_WITH_ALCHEMY_KEY>

# Keagate webhook signing secret
KEAGATE_WEBHOOK_SECRET=<REPLACE_WITH_64_CHAR_HEX_STRING>

# =============================================================================
# YIELD ENGINE — port 3007
# =============================================================================

PORT_YIELD_ENGINE=3007

# Use simulated yields in staging (no real DeFi protocol calls)
USE_SIMULATED_YIELDS=true
SIMULATED_YIELD_RATE_APY=0.05

# Ondo Finance API (staging/testnet)
ONDO_API_KEY=<REPLACE_WITH_ONDO_SANDBOX_KEY>
ONDO_ENVIRONMENT=sandbox

# Aave testnet integration
AAVE_POOL_ADDRESS_GOERLI=0x368EedF3f56ad10b9bC57eed4Dac65B26Bb667f6

# =============================================================================
# RWA REGISTRY — port 3008
# =============================================================================

PORT_RWA_REGISTRY=3008

# Ondo RWA asset contracts (testnet addresses)
ONDO_USDY_CONTRACT=0x0000000000000000000000000000000000000000  # set after testnet deploy
ONDO_TBILL_CONTRACT=0x0000000000000000000000000000000000000000
ONDO_BUIDL_CONTRACT=0x0000000000000000000000000000000000000000

# RWA registry signing key
RWA_REGISTRY_SIGNING_KEY=<REPLACE_WITH_ED25519_PRIVATE_KEY>

# =============================================================================
# ENTERPRISE TREASURY — port 3012
# =============================================================================

PORT_ENTERPRISE_TREASURY=3012

# Treasury FX API (sandbox)
FX_PROVIDER=sandbox
FX_API_KEY=<REPLACE_WITH_FX_SANDBOX_KEY>

# Treasury approval threshold (USD) — low for staging testing
TREASURY_APPROVAL_THRESHOLD_USD=100

# =============================================================================
# AGENT IDENTITY — port 3010
# =============================================================================

PORT_AGENT_IDENTITY=3010

# Agent DID registry (IPFS/testnet)
AGENT_DID_METHOD=did:key
AGENT_REGISTRY_CHAIN=polygon-mumbai

# Agent identity signing key
AGENT_IDENTITY_SIGNING_KEY=<REPLACE_WITH_ED25519_PRIVATE_KEY>

# =============================================================================
# AGENT NEGOTIATION — port 3011
# =============================================================================

PORT_AGENT_NEGOTIATION=3011

# USDC escrow contract (Mumbai testnet)
ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000  # deploy and set

# Agent identity service URL
AGENT_IDENTITY_URL=http://agent-identity.${INTERNAL_DOMAIN}:3010

# =============================================================================
# AGENT DECISION FRAMEWORK — port 3013
# =============================================================================

PORT_AGENT_DECISION_FRAMEWORK=3013

# LLM provider for agent routing decisions (Claude)
ANTHROPIC_API_KEY=<REPLACE_WITH_ANTHROPIC_API_KEY>
AGENT_MODEL=claude-opus-4-7

# Decision confidence threshold (0.0–1.0)
DECISION_CONFIDENCE_THRESHOLD=0.7

# Downstream service URLs
UNIFIED_ROUTER_URL=http://unified-router.${INTERNAL_DOMAIN}:3000
COMPLIANCE_MONITOR_URL=http://compliance-monitor.${INTERNAL_DOMAIN}:8001

# =============================================================================
# AGENT CREDIT LINES — port 3016
# =============================================================================

PORT_AGENT_CREDIT_LINES=3016

# Maximum credit line allowed in staging (USD)
CREDIT_LINE_MAX_LIMIT_USD=1000

# Credit scoring service (internal)
CREDIT_SCORING_URL=http://agent-decision-framework.${INTERNAL_DOMAIN}:3013

# Risk threshold for auto-approval (0.0–1.0, lower = more conservative)
CREDIT_AUTO_APPROVE_RISK_THRESHOLD=0.3

# =============================================================================
# COMPLIANCE MONITOR — port 8001
# =============================================================================

PORT_COMPLIANCE_MONITOR=8001

# OFAC screening — disabled in staging (use sandbox mode)
OFAC_SCREENING_ENABLED=false
OFAC_API_KEY=<REPLACE_WITH_OFAC_SANDBOX_KEY>

# Onfido KYC (sandbox)
ONFIDO_API_KEY=<REPLACE_WITH_ONFIDO_SANDBOX_KEY>
ONFIDO_ENVIRONMENT=sandbox

# Chainalysis blockchain risk scoring (sandbox)
CHAINALYSIS_API_KEY=<REPLACE_WITH_CHAINALYSIS_KEY>
CHAINALYSIS_ENVIRONMENT=sandbox

# Compliance alert webhook
COMPLIANCE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/<REPLACE_WITH_SLACK_WEBHOOK>

# =============================================================================
# LIQUIDITY FORECASTER — port 8002
# =============================================================================

PORT_LIQUIDITY_FORECASTER=8002

# Forecasting model config
FORECAST_HORIZON_DAYS=30
FORECAST_MODEL=prophet   # prophet | arima | lstm

# Historical data lookback (days)
FORECAST_LOOKBACK_DAYS=90

# =============================================================================
# BANK CONNECTIVITY — port 3003
# =============================================================================

PORT_BANK_CONNECTIVITY=3003

# Open banking provider (TrueLayer sandbox)
TRUELAYER_CLIENT_ID=<REPLACE_WITH_TRUELAYER_SANDBOX_CLIENT_ID>
TRUELAYER_CLIENT_SECRET=<REPLACE_WITH_TRUELAYER_SANDBOX_SECRET>
TRUELAYER_ENVIRONMENT=sandbox

# Plaid sandbox
PLAID_CLIENT_ID=<REPLACE_WITH_PLAID_CLIENT_ID>
PLAID_SECRET=<REPLACE_WITH_PLAID_SANDBOX_SECRET>
PLAID_ENVIRONMENT=sandbox

# =============================================================================
# CHAIN SYNC — port 8040 (disabled in staging by default)
# =============================================================================

PORT_CHAIN_SYNC=8040

# Chain sync is disabled unless ZK contract integration is being tested.
# Set CHAIN_SYNC_ENABLED=true and deploy on a feature branch.
CHAIN_SYNC_ENABLED=false

# Alchemy API key for EVM event subscriptions
ALCHEMY_API_KEY=<REPLACE_WITH_ALCHEMY_KEY>

# =============================================================================
# BANK WHITELABEL — port 3015
# =============================================================================

PORT_BANK_WHITELABEL=3015

# Whitelabel brand config (loaded at runtime from this env)
WHITELABEL_BRAND_NAME=ForgePay Staging
WHITELABEL_PRIMARY_COLOR=#0A2540
WHITELABEL_ACCENT_COLOR=#00F0FF

# =============================================================================
# ACCOUNTS SERVICE — port 3020
# =============================================================================

PORT_ACCOUNTS_SERVICE=3020

# Circle sandbox for USD/USDC accounts
CIRCLE_ACCOUNTS_API_KEY=<REPLACE_WITH_CIRCLE_SANDBOX_KEY>
CIRCLE_ACCOUNTS_ENVIRONMENT=sandbox

# Account deposit limits (USD) — reduced for staging
ACCOUNTS_MIN_DEPOSIT_USD=1
ACCOUNTS_MAX_DEPOSIT_USD=1000

# Onfido KYC (shared with compliance-monitor)
ONFIDO_ACCOUNTS_API_KEY=<REPLACE_WITH_ONFIDO_SANDBOX_KEY>
ONFIDO_ACCOUNTS_ENVIRONMENT=sandbox

# Default blockchain for stablecoin accounts
ACCOUNTS_DEFAULT_CHAIN=polygon

# =============================================================================
# INSTITUTIONAL REPORTING — port 3021
# =============================================================================

PORT_INSTITUTIONAL_REPORTING=3021

# Report export storage
REPORTS_S3_BUCKET=forgepay-reports-staging-${AWS_ACCOUNT_ID}
REPORTS_S3_PREFIX=institutional/

# Report signing key for integrity
REPORTS_SIGNING_KEY=<REPLACE_WITH_REPORTS_SIGNING_KEY>

# =============================================================================
# OBSERVABILITY
# =============================================================================

# Grafana admin credentials (staging)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<REPLACE_WITH_GRAFANA_ADMIN_PASSWORD>

# Prometheus remote write (optional — for long-term metrics storage)
PROMETHEUS_REMOTE_WRITE_URL=

# Loki (log aggregation) — uses internal cluster service
LOKI_URL=http://loki.forgepay-staging.svc.cluster.local:3100

# Jaeger (tracing) — uses internal cluster service
JAEGER_AGENT_HOST=jaeger-agent.forgepay-staging.svc.cluster.local
JAEGER_AGENT_PORT=6831

# =============================================================================
# NOTIFICATIONS (optional)
# =============================================================================

# Slack webhook for deploy/alert notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/<REPLACE_WITH_SLACK_WEBHOOK>

# Alert email (matches Terraform alert_email variable)
ALERT_EMAIL=devops@forgepay.io

# =============================================================================
# STAGING-SPECIFIC FLAGS
# =============================================================================

# Log verbosity for all services
LOG_LEVEL=debug

# Disable rate limiting in staging for easier testing
RATE_LIMIT_ENABLED=false

# Disable HTTPS-only cookie flag (since staging may not always have valid TLS)
COOKIE_SECURE=false

# Enable extra debug headers in API responses
DEBUG_HEADERS_ENABLED=true

# x402 payment verification (skip real on-chain verify in staging)
X402_VERIFY_ON_CHAIN=false
