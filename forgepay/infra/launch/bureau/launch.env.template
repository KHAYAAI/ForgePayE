# Production settings for the credit bureau launch. This file holds NO secrets: every value below is a
# placeholder or a non-secret setting. Generate real secrets with generate-secrets.sh (writes outside the
# repo) and keep them in AWS Secrets Manager or Vault, never in git or Helm values.
# Check a filled-in file with:  node preflight.mjs /path/to/launch.env

# ── Shared ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Bureau service (services/agent-credit-bureau) ────────────────────────
CORS_ORIGIN=https://console.myforgepay.com
DATABASE_URL=                          # secret: postgres connection string
REDIS_URL=                             # shared rate limiting across replicas
BUREAU_ADMIN_API_KEY=                  # secret (generate-secrets.sh): same value in the console
CONSENT_SIGNING_SECRET=                # secret (generate-secrets.sh)
WEBHOOK_SIGNING_MASTER=               # secret (generate-secrets.sh): derives every institution's webhook signing secret; the bureau refuses to start without it
COMPLIANCE_MONITOR_URL=                # e.g. http://compliance-monitor:8003
COMPLIANCE_MONITOR_API_KEY=            # secret: only if compliance-monitor has REQUIRE_AUTH on
AGENT_IDENTITY_URL=                    # e.g. http://agent-identity:3010
TRUST_PROXY_HOPS=1                     # number of proxies in front (CloudFront + load balancer = 2)
# Leave unset: the zero-knowledge proof endpoint is a stub and stays disabled in production.
# ZK_STUB_PROOFS_ACKNOWLEDGED=

# ── Mode 2 activity indexer (off by default; see docs/launch/10-mode2-activity-indexer.md) ──
# Reads each agent's own wallet (stablecoin transfers) from public chains. Leave off until you have an RPC provider.
ONCHAIN_INDEXER_ENABLED=false
# JSON array, one entry per chain. Token addresses are NOT defaulted: copy them from each issuer's published list and
# check them before enabling (a wrong address silently scores the wrong asset). Only list USD stablecoins worth $1.
# The RPC URL carries your provider key: treat the whole value as a secret.
# ONCHAIN_CHAINS=[{"chainId":8453,"name":"Base","rpcUrl":"<provider url>","startBlock":<first block worth scanning>,"confirmations":12,"maxBlockRange":2000,"tokens":[{"symbol":"USDC","address":"<issuer-published address>","decimals":6}]}]
# Optional: ONCHAIN_MIN_TRANSFERS=5  ONCHAIN_MIN_COUNTERPARTIES=3  ONCHAIN_DUST_CENTS=1  ONCHAIN_INDEX_INTERVAL_MS=30000

# ── Compliance monitor (services/compliance-monitor) ─────────────────────
# Production screening refuses to clear anyone until the South African TFS list loads.
# Stopgap until a download address is confirmed: a recorded copy of the FIC list bundled in the image
# (services/compliance-monitor/src/data/za_tfs_snapshot.xml, 1,002 entries, taken 6 October 2026). Its age counts from
# the snapshot date, so it goes stale on schedule. 720 hours (30 days) is the owner's accepted limit for this list only.
# To update: replace the file, change ZA_TFS_SNAPSHOT_AT, redeploy.
ZA_TFS_URL=file:///app/src/data/za_tfs_snapshot.xml
ZA_TFS_SNAPSHOT_AT=2026-10-06T07:23:00Z
ZA_TFS_MAX_AGE_HOURS=720
# Target, once it is confirmed to serve automated downloads (the monitor then refreshes on its own schedule):
#   ZA_TFS_URL=https://tfs.fic.gov.za/Pages/TFSListDownload?fileType=xml

# ── Console (apps/platform) ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://console.myforgepay.com
JWT_SECRET=                            # secret (generate-secrets.sh)
INTERNAL_WEBHOOK_SECRET=               # secret (generate-secrets.sh): shared with unified-router
AGENT_CREDIT_BUREAU_URL=               # e.g. http://agent-credit-bureau:3018
FORGE_OPERATOR_TENANT_ID=              # the console workspace id that operates the bureau (sees every agent)
FORGE_LAUNCHED_PRODUCTS=credit-bureau  # products open to every workspace
