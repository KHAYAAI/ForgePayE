# Production settings for the credit bureau launch. This file holds NO secrets: every value below is a
# placeholder or a non-secret setting. Generate real secrets with generate-secrets.sh (writes outside the
# repo) and keep them in AWS Secrets Manager or Vault, never in git or Helm values.
# Check a filled-in file with:  node preflight.mjs /path/to/launch.env

# ── Shared ────────────────────────────────────────────────────────────────
NODE_ENV=production

# ── Bureau service (services/agent-credit-bureau) ────────────────────────
CORS_ORIGIN=https://console.myforgepay.com
DATABASE_URL=                          # secret: postgres connection string
REDIS_URL=                             # shared rate limiting across replicas
BUREAU_ADMIN_API_KEY=                  # secret (generate-secrets.sh): same value in the console
CONSENT_SIGNING_SECRET=                # secret (generate-secrets.sh)
COMPLIANCE_MONITOR_URL=                # e.g. http://compliance-monitor:8003
COMPLIANCE_MONITOR_API_KEY=            # secret: only if compliance-monitor has REQUIRE_AUTH on
AGENT_IDENTITY_URL=                    # e.g. http://agent-identity:3010
TRUST_PROXY_HOPS=1                     # number of proxies in front (CloudFront + load balancer = 2)
# Leave unset: the zero-knowledge proof endpoint is a stub and stays disabled in production.
# ZK_STUB_PROOFS_ACKNOWLEDGED=

# ── Compliance monitor (services/compliance-monitor) ─────────────────────
# Production screening refuses to clear anyone until the South African TFS list loads.
# An address the service can download from on a schedule. The file format is the FIC's XML dataset and is
# detected automatically (the column settings only apply if the address serves a CSV).
ZA_TFS_URL=https://tfs.fic.gov.za/Pages/TFSListDownload?fileType=xml   # supplied by the owner; not yet fetched from a network that can reach it

# ── Console (apps/platform) ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://console.myforgepay.com
JWT_SECRET=                            # secret (generate-secrets.sh)
INTERNAL_WEBHOOK_SECRET=               # secret (generate-secrets.sh): shared with unified-router
AGENT_CREDIT_BUREAU_URL=               # e.g. http://agent-credit-bureau:3018
FORGE_OPERATOR_TENANT_ID=              # the console workspace id that operates the bureau (sees every agent)
FORGE_LAUNCHED_PRODUCTS=credit-bureau  # products open to every workspace
