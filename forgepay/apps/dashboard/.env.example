# ForgePay Merchant Dashboard — no .env.example existed for this app before.

NODE_ENV=development

# ── Auth (NextAuth, credentials against a real mor-layer merchant account) ──
# REQUIRED in production — refuses to boot with the dev fallback or under 32
# chars. See src/lib/nextauth-secret.ts.
#   openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# mor-layer holds the real merchant accounts (bcrypt-hashed passwords) this
# app's login screen authenticates against — see src/lib/auth.ts.
MOR_LAYER_URL=http://localhost:8010

# Dev/CI-only fallback API key used if a request has no authenticated
# session (see src/lib/session.ts's UnauthorizedError path). Must NEVER be
# set in a production secret store.
#HYPERSWITCH_MERCHANT_API_KEY=

# ── Hyperswitch (payment-engine) ────────────────────────────────────────────
HYPERSWITCH_BASE_URL=http://localhost:8080
HYPERSWITCH_API_KEY=

# ── Kill Bill (subscriptions/billing) ───────────────────────────────────────
KILLBILL_URL=http://localhost:8020
KILLBILL_BASE_URL=http://localhost:8020
KILLBILL_API_KEY=forgepay
KILLBILL_API_SECRET=forgepay
KILLBILL_DEFAULT_ACCOUNT_ID=
KILL_BILL_URL=http://localhost:8020
KILL_BILL_AUTH=

# ── Backend service URLs ─────────────────────────────────────────────────────
AGENT_CREDIT_LINES_URL=http://localhost:3021
AGENT_DECISION_FRAMEWORK_URL=http://localhost:3013
AGENT_IDENTITY_URL=http://localhost:3010
BANK_CONNECTIVITY_URL=http://localhost:3022
ENTERPRISE_TREASURY_URL=http://localhost:8060
UNIFIED_ROUTER_URL=http://localhost:8000

FORGEPAY_API_KEY=
FORGEPAY_WEBHOOK_SECRET=
INTERNAL_WEBHOOK_SECRET=

# ── Forge Agent (AI billing assistant, packages/forge-agent) ───────────────
FORGE_AGENT_ENABLED=false
FORGE_AGENT_BILLING_ENABLED=false
FORGE_AGENT_MODEL=claude-sonnet-5
FORGE_AGENT_MAX_TOKENS=4096
FORGE_AGENT_MEMORY_ENABLED=false
NEXT_PUBLIC_FORGE_AGENT_ENABLED=false
ANTHROPIC_API_KEY=

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://localhost:5432/forgepay_dashboard

# ── Feature flags ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SHIELDED_ENABLED=false
