# ForgePay Console — no .env.example existed for this app before this file.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. Run `npm run db:migrate` (lib/schema.sql) after setting this.
DATABASE_URL=postgresql://forgepay:devpassword@localhost:5432/forgepay_dev

# ── Sessions & auth ──────────────────────────────────────────────────────────
# Signs session JWTs and the short-lived MFA-pending token. REQUIRED in
# production, refuses to boot with the dev fallback or under 32 chars — see
# lib/jwt-secret.ts.
#   openssl rand -hex 32
JWT_SECRET=

# ── SSO (WorkOS) ─────────────────────────────────────────────────────────────
# Optional — the console works with password + TOTP login when unset (see
# isSsoConfigured() in lib/sso.ts). Set both to enable "Sign in with SSO":
# create a WorkOS account (https://dashboard.workos.com), configure an SSO
# connection for each enterprise customer's IdP (Okta/Azure AD/Google
# Workspace/SAML), and set tenants.workos_organization_id +
# tenants.domain for that customer (see lib/schema.sql). Set
# tenants.sso_required=true to require SSO login and block password login
# for that tenant's users.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Must exactly match a redirect URI registered in the WorkOS dashboard.
# Falls back to `${NEXT_PUBLIC_APP_URL}/api/auth/sso/callback` if unset.
#WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# ── Email (nodemailer) ───────────────────────────────────────────────────────
# Signup/onboarding/API-key emails. Unset → sendVerificationEmail() etc. log
# and fail gracefully rather than blocking the request.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ForgePay <noreply@forgepay.io>

# ── Redis ────────────────────────────────────────────────────────────────────
# Backs the email send queue (lib/email-queue.ts).
REDIS_URL=redis://localhost:6379

# ── Kill Bill (subscriptions/billing) ───────────────────────────────────────
KILLBILL_BASE_URL=http://localhost:8080
KILLBILL_API_KEY=
KILLBILL_API_SECRET=
KILLBILL_TENANT_ID=

# ── Backend service URLs (console → platform services) ─────────────────────
FORGE_WALLET_URL=http://localhost:3020
FORGE_CUSTODY_URL=http://localhost:3019
AGENT_CREDIT_BUREAU_URL=http://localhost:3018
ENTERPRISE_TREASURY_URL=http://localhost:8060
UNIFIED_ROUTER_URL=http://localhost:8000
API_BASE_URL=http://localhost:3000

# Shared secret the console presents to those services' internal console
# endpoints (e.g. forge-wallet's GET /api/v1/console/summary).
CONSOLE_SECRET=
CONSOLE_MERCHANT_ID=
FORGE_API_KEY=
INTERNAL_WEBHOOK_SECRET=

# ── Test-only ────────────────────────────────────────────────────────────────
TEST_API_KEY=
