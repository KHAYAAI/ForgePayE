# ForgePay Console — no .env.example existed for this app before this file.

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. Run `npm run db:migrate` (lib/schema.sql) after setting this.
DATABASE_URL=postgresql://forgepay:devpassword@localhost:5432/forgepay_dev

# ── Sessions & auth ──────────────────────────────────────────────────────────
# Signs session JWTs and the short-lived MFA-pending token. REQUIRED in
# production, refuses to boot with the dev fallback or under 32 chars — see
# lib/jwt-secret.ts.
#   openssl rand -hex 32
JWT_SECRET=

# ── SSO (WorkOS) ─────────────────────────────────────────────────────────────
# Optional — the console works with password + TOTP login when unset (see
# isSsoConfigured() in lib/sso.ts). Set both to enable "Sign in with SSO":
# create a WorkOS account (https://dashboard.workos.com), configure an SSO
# connection for each enterprise customer's IdP (Okta/Azure AD/Google
# Workspace/SAML), and set tenants.workos_organization_id +
# tenants.domain for that customer (see lib/schema.sql). Set
# tenants.sso_required=true to require SSO login and block password login
# for that tenant's users.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# Must exactly match a redirect URI registered in the WorkOS dashboard.
# Falls back to `${NEXT_PUBLIC_APP_URL}/api/auth/sso/callback` if unset.
#WORKOS_REDIRECT_URI=http://localhost:3000/api/auth/sso/callback

# ── Email (nodemailer) ───────────────────────────────────────────────────────
# Signup/onboarding/API-key emails. Unset → sendVerificationEmail() etc. log
# and fail gracefully rather than blocking the request.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ForgePay <noreply@forgepay.io>

# ── Redis ────────────────────────────────────────────────────────────────────
# Backs the email send queue (lib/email-queue.ts).
REDIS_URL=redis://localhost:6379

# ── Kill Bill (subscriptions/billing) ───────────────────────────────────────
KILLBILL_BASE_URL=http://localhost:8080
KILLBILL_API_KEY=
KILLBILL_API_SECRET=
KILLBILL_TENANT_ID=

# ── Backend service URLs (console → platform services) ─────────────────────
AGENT_CREDIT_BUREAU_URL=http://localhost:3018
ENTERPRISE_TREASURY_URL=http://localhost:8060
UNIFIED_ROUTER_URL=http://localhost:8000
API_BASE_URL=http://localhost:3000

CONSOLE_MERCHANT_ID=
FORGE_API_KEY=
INTERNAL_WEBHOOK_SECRET=

# The bureau's operator key — must match BUREAU_ADMIN_API_KEY on the
# agent-credit-bureau service itself (see services/agent-credit-bureau/src/
# auth.ts). The console reads and resolves disputes across every agent, which
# only the admin key can do. Unset falls back to the bureau's own dev key, so
# local dev works without configuring both sides — REQUIRED in production.
BUREAU_ADMIN_API_KEY=

# ── FORGE Wallet backend (open-privy) ───────────────────────────────────────
# FORGE Wallet is backed by open-privy (github.com/KHAYAAI/open-privy,
# services/backend — a real NestJS service with its own Postgres database),
# not a service in this repo. See lib/openprivy.ts.
#
# open-privy's own signup/login requires Supabase (and SSO requires WorkOS),
# neither of which the console runs. Instead the console provisions one
# open-privy `users` row per FORGE tenant directly in its database on first
# wallet access, and mints short-lived JWTs for it with OPENPRIVY_JWT_SECRET
# — which therefore MUST equal open-privy's own JWT_SECRET, or every call
# will 401.
OPENPRIVY_URL=http://localhost:3021
OPENPRIVY_DATABASE_URL=postgresql://forgepay:devpassword@localhost:5432/forgepay_openprivy
OPENPRIVY_JWT_SECRET=

# ── FORGE Custody backend (openfireblocks) ───────────────────────────────────
# FORGE Custody is backed by services/openfireblocks (see lib/openfireblocks.ts).
# Each FORGE tenant is an openfireblocks customer with the same id. The console
# calls openfireblocks' admin-scoped custody API with OPENFIREBLOCKS_ADMIN_KEY,
# which MUST equal the gateway's own ADMIN_API_KEY, and names the acting person
# on every call so openfireblocks can check they are an active signer.
OPENFIREBLOCKS_URL=http://localhost:8090
OPENFIREBLOCKS_ADMIN_KEY=

# ── Test-only ────────────────────────────────────────────────────────────────
TEST_API_KEY=

# ── Launch gate and bureau tenancy ──
# Products open to every workspace (comma-separated). Empty in production means credit-bureau only.
FORGE_LAUNCHED_PRODUCTS=
# Workspaces admitted to custody before it launches generally (design partners).
FORGE_DESIGN_PARTNERS_CUSTODY=
# FORGE's own operator workspace: sees the whole bureau register and resolves disputes.
# Every other workspace sees only the agents it registered.
FORGE_OPERATOR_TENANT_ID=
