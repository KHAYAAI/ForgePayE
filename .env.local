# .env.local — local development secrets (never commit to git)
# This file is gitignored and only used for local dev with docker-compose.dev.yml

# Unified Router webhook secrets — must match docker-compose env vars
KILLBILL_WEBHOOK_SECRET=dev-kb-secret-12345
HYPERSWITCH_WEBHOOK_SECRET=dev-hs-secret
STABLECOIN_WEBHOOK_SECRET=dev-sc-secret
CRYPTO_WEBHOOK_SECRET=dev-crypto-secret
INTERNAL_WEBHOOK_SECRET=dev-internal-secret-change-me

# Kill Bill (billing-engine) secrets
KILLBILL_ADMIN_PASSWORD=killbill
MYSQL_PASSWORD=killbill_dev_password

# PostgreSQL (shared)
POSTGRES_PASSWORD=devpassword

# Redis (shared)
REDIS_URL=redis://localhost:6379

# Node environment
NODE_ENV=development

# Service URLs (for docker-compose networking)
POSTGRES_HOST=postgres
POSTGRES_DB=forgepay_dev
POSTGRES_USER=forgepay
UNIFIED_ROUTER_URL=http://unified-router:8000
PAYMENT_ENGINE_URL=http://payment-engine:8080
STABLECOIN_GATEWAY_URL=http://stablecoin-gateway:8020
CRYPTO_GATEWAY_URL=http://crypto-gateway:8030
