# .env.local.example — local development secrets template
#
# Copy to .env.local and fill in real values for local dev with
# docker-compose.dev.yml. .env.local itself is gitignored (see .gitignore)
# — never commit it. (An earlier .env.local *was* committed with real-looking
# dev-only values; it has been removed from tracking, but rotate anything in
# it you reused elsewhere, since it was pushed to the remote.)

# Unified Router webhook secrets — must match docker-compose env vars
KILLBILL_WEBHOOK_SECRET=
HYPERSWITCH_WEBHOOK_SECRET=
STABLECOIN_WEBHOOK_SECRET=
CRYPTO_WEBHOOK_SECRET=
INTERNAL_WEBHOOK_SECRET=

# Kill Bill (billing-engine) secrets
KILLBILL_ADMIN_PASSWORD=
MYSQL_PASSWORD=

# PostgreSQL (shared)
POSTGRES_PASSWORD=

# Redis (shared)
REDIS_URL=redis://localhost:6379

# Node environment
NODE_ENV=development

# Service URLs (for docker-compose networking)
POSTGRES_HOST=localhost
POSTGRES_DB=forgepay_dev
POSTGRES_USER=forgepay
UNIFIED_ROUTER_URL=http://unified-router:8000
PAYMENT_ENGINE_URL=http://payment-engine:8080
STABLECOIN_GATEWAY_URL=http://stablecoin-gateway:3000
CRYPTO_GATEWAY_URL=http://crypto-gateway:3000
